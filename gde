    def __init__(self, readonly: bool = False):
        global _UI_OFF
        _UI_OFF = True  # stdout milik protokol JSON-RPC: jangan pernah render UI
        self.readonly = readonly or (os.environ.get("GDE_MCP_READONLY", "0").lower() in ("1", "true", "yes"))

    def handle_request(self, req: dict, conn_override=None) -> Optional[Dict[str, Any]]:
        """Process a single JSON-RPC 2.0 message."""
        method = req.get("method")
        msg_id = req.get("id")

        if msg_id is None:
            # Notifications (no id) require no response
            return None

        if method == "initialize":
            return {
                "jsonrpc": "2.0",
                "id": msg_id,
                "result": {
                    "protocolVersion": self.PROTOCOL_VERSION,
                    "capabilities": {
                        "tools": {}
                    },
                    "serverInfo": self.SERVER_INFO
                }
            }

        elif method == "ping":
            return {
                "jsonrpc": "2.0",
                "id": msg_id,
                "result": {}
            }

        elif method == "tools/list":
            return {
                "jsonrpc": "2.0",
                "id": msg_id,
                "result": {
                    "tools": self.TOOLS
                }
            }

        elif method == "tools/call":
            params = req.get("params", {})
            name = params.get("name")
            args = params.get("arguments", {})
            try:
                res_data = self._dispatch_tool(name, args, conn_override=conn_override)
                return {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": {
                        "content": [
                            {
                                "type": "text",
                                "text": json.dumps(res_data, indent=2) if isinstance(res_data, (dict, list)) else str(res_data)
                            }
                        ],
                        "isError": False
                    }
                }
            except Exception as e:
                return {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": {
                        "content": [
                            {
                                "type": "text",
                                "text": f"Tool error ({name}): {e}"
                            }
                        ],
                        "isError": True
                    }
                }

        else:
            return {
                "jsonrpc": "2.0",
                "id": msg_id,
                "error": {
                    "code": -32601,
                    "message": f"Method not found: {method}"
                }
            }

    def _dispatch_tool(self, name: str, args: dict, conn_override=None):
        if self.readonly and name in ("gde_encrypt", "gde_decrypt", "gde_download", "gde_import_keys", "gde_delete"):
            raise PermissionError(f"GDE MCP Server is running in read-only mode. Mutation tool '{name}' is blocked.")

        if name == "gde_encrypt":
            path = args.get("path")
            if not path:
                raise ValueError("Argument 'path' is required.")
            local_only = bool(args.get("local_only", False))
            allow_partial = bool(args.get("allow_partial", False))
            force = bool(args.get("force", False))
            return self._tool_encrypt(path, local_only=local_only, allow_partial=allow_partial, force=force, conn_override=conn_override)

        elif name == "gde_decrypt":
            enc_path = args.get("enc_path")
            if not enc_path:
                raise ValueError("Argument 'enc_path' is required.")
            dest_dir = args.get("dest_dir", ".")
            force = bool(args.get("force", False))
            key_hex = args.get("key_hex")
            return self._tool_decrypt(enc_path, dest_dir=dest_dir, force=force, key_hex=key_hex, conn_override=conn_override)

        elif name == "gde_list":
            return self._tool_list(conn_override=conn_override)

        elif name == "gde_download":
            item = args.get("item_id_or_label")
            if not item:
                raise ValueError("Argument 'item_id_or_label' is required.")
            dest_dir = args.get("dest_dir", ".")
            force = bool(args.get("force", False))
            return self._tool_download(item, dest_dir=dest_dir, force=force, conn_override=conn_override)

        elif name == "gde_status":
            return self._tool_status(conn_override=conn_override)

        elif name == "gde_export_keys":
            if os.environ.get("GDE_MCP_ALLOW_EXPORT", "1").lower() in ("0", "false", "no"):
                raise PermissionError("Key export via MCP is disabled by configuration (GDE_MCP_ALLOW_EXPORT=0).")
            out_path = args.get("out_path")
            return self._tool_export_keys(out_path=out_path, conn_override=conn_override)

        elif name == "gde_import_keys":
            in_path = args.get("in_path")
            if not in_path:
                raise ValueError("Argument 'in_path' is required.")
            return self._tool_import_keys(in_path, conn_override=conn_override)
        elif name == "gde_delete":
            item = args.get("item_id_or_label")
            if not item:
                raise ValueError("Argument 'item_id_or_label' is required.")
            delete_remote = bool(args.get("delete_remote", True))
            rc = cmd_delete([str(item)], delete_remote=delete_remote, force=True, conn_override=conn_override)
            if rc != 0:
                raise RuntimeError(f"Gagal menghapus entri vault untuk: {item}")
            return {"status": "success", "message": f"Vault item '{item}' successfully deleted."}

        else:
            raise ValueError(f"Unknown tool name: {name}")

    def _tool_encrypt(self, path_str: str, local_only: bool = False, allow_partial: bool = False, force: bool = False, conn_override=None):
        target = Path(path_str).expanduser().resolve()
        if not target.exists() and not os.path.islink(target):
            raise FileNotFoundError(f"Path '{target}' not found.")

        if not is_safe_mcp_path(target):
            raise PermissionError(f"Access to path '{target}' is restricted for MCP security.")

        st = os.lstat(target)
        if stat.S_ISFIFO(st.st_mode) or stat.S_ISSOCK(st.st_mode) or stat.S_ISCHR(st.st_mode) or stat.S_ISBLK(st.st_mode):
            raise ValueError(f"Special file '{target.name}' is not supported.")

        is_dir = 1 if stat.S_ISDIR(st.st_mode) and not os.path.islink(target) else 0
        if not is_dir and not stat.S_ISREG(st.st_mode) and not os.path.islink(target):
            raise ValueError(f"Target '{target.name}' is not a regular file or directory.")

        conn = conn_override or init_db()
        label = f"gde_{secrets.token_hex(8)}"

        if is_dir:
            size_bytes = sum(f.stat().st_size for f in target.glob("**/*") if f.is_file() and not os.path.islink(f))
        else:
            size_bytes = target.stat().st_size if not os.path.islink(target) else 0

        with tempfile.TemporaryDirectory() as tmpdir:
            tmp = Path(tmpdir)
            temp_enc = tmp / f"{label}.enc"
            unreadable_items = []
            special_files = []

            if is_dir:
                zip_path = tmp / "data.zip"
                unreadable_items, special_files = compress_directory(target, zip_path)
                with open(zip_path, "rb") as f:
                    raw_bytes = f.read()
            else:
                with open(target, "rb") as f:
                    raw_bytes = f.read()

            enc_bytes, key = encrypt_data(raw_bytes, label)
            with open(temp_enc, "wb") as f:
                f.write(enc_bytes)

            created_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

            if local_only:
                out_enc = Path.cwd() / f"{target.name}.enc"
                if out_enc.exists() and not force:
                    out_enc = Path.cwd() / f"{target.name}.{secrets.token_hex(4)}.enc"

                old_label = None
                if out_enc.exists():
                    try:
                        with open(out_enc, "rb") as old_fp:
                            old_header = old_fp.read(64)
                            if len(old_header) >= 5 and old_header[:4] in (MAGIC_GDE, MAGIC_EGD):
                                l_len = old_header[4]
                                old_label = old_header[5:5 + l_len].decode("utf-8", errors="ignore")
                    except Exception:
                        pass

                conn.execute(
                    """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
                       VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                    (label, target.name, str(target), is_dir, size_bytes, key.hex(), None, created_at)
                )
                conn.commit()

                try:
                    atomic_copy_file(temp_enc, out_enc, mode=0o644)
                    if old_label and old_label != label:
                        conn.execute("DELETE FROM vault WHERE label = ? AND drive_file_id IS NULL", (old_label,))
                        conn.commit()
                except Exception as e:
                    conn.execute("DELETE FROM vault WHERE label = ?", (label,))
                    conn.commit()
                    raise RuntimeError(f"Failed to write encrypted file to {out_enc}: {e}")

                return {
                    "status": "success",
                    "mode": "local",
                    "label": label,
                    "original_name": target.name,
                    "original_path": str(target),
                    "is_dir": bool(is_dir),
                    "size_bytes": size_bytes,
                    "output_file": str(out_enc),
                    "unreadable_skipped": len(unreadable_items),
                    "special_skipped": len(special_files)
                }

            # Cloud mode
            conn.execute(
                """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
                   VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                (label, target.name, str(target), is_dir, size_bytes, key.hex(), None, created_at)
            )
            conn.commit()

            mcp = GDriveMCP()
            drive_file_id = None
            upload_err = None
            try:
                mcp.start()
                drive_file_id = mcp.upload_file(temp_enc, f"{label}.enc")
                conn.execute("UPDATE vault SET drive_file_id = ? WHERE label = ?", (drive_file_id, label))
                conn.commit()
            except Exception as e:
                upload_err = e
            finally:
                mcp.close()

            if upload_err:
                fallback_enc = Path.cwd() / f"{target.name}.enc"
                if fallback_enc.exists() and not force:
                    fallback_enc = Path.cwd() / f"{target.name}.{secrets.token_hex(4)}.enc"
                atomic_copy_file(temp_enc, fallback_enc, mode=0o644)
                return {
                    "status": "warning",
                    "mode": "fallback_local",
                    "label": label,
                    "original_name": target.name,
                    "original_path": str(target),
                    "is_dir": bool(is_dir),
                    "size_bytes": size_bytes,
                    "drive_file_id": None,
                    "saved_local_path": str(fallback_enc),
                    "warning": f"Google Drive upload failed ({upload_err}). Ciphertext safely saved locally to disk to prevent data loss.",
                    "unreadable_skipped": len(unreadable_items),
                    "special_skipped": len(special_files)
                }

            return {
                "status": "success",
                "mode": "cloud",
                "label": label,
                "original_name": target.name,
                "original_path": str(target),
                "is_dir": bool(is_dir),
                "size_bytes": size_bytes,
                "drive_file_id": drive_file_id,
                "unreadable_skipped": len(unreadable_items),
                "special_skipped": len(special_files)
            }

    def _tool_decrypt(self, enc_path_str: str, dest_dir: str = ".", force: bool = False, key_hex: str = None, conn_override=None):
        enc_path = Path(enc_path_str).expanduser().resolve()
        if not enc_path.exists():
            raise FileNotFoundError(f"Encrypted file '{enc_path}' not found.")

        if not is_safe_mcp_path(enc_path):
            raise PermissionError(f"Access to encrypted file '{enc_path}' is restricted for MCP security.")

        with open(enc_path, "rb") as f:
            enc_data = f.read()

        if len(enc_data) < 5:
            raise ValueError("File format invalid (too short).")

        magic = enc_data[:4]
        if magic not in (MAGIC_GDE, MAGIC_EGD):
            raise ValueError("Not a valid GDE/EGD encrypted file.")

        label_len = enc_data[4]
        label = enc_data[5:5 + label_len].decode("utf-8", errors="ignore")

        conn = conn_override or init_db()
        cur = conn.cursor()
        cur.execute("SELECT original_name, is_dir, enc_key FROM vault WHERE label = ?", (label,))
        row = cur.fetchone()

        if row:
            name, is_dir, key_hex_db = row
            key = bytes.fromhex(key_hex_db)
        elif key_hex:
            try:
                key = bytes.fromhex(key_hex.strip())
                if len(key) != 32:
                    raise ValueError("Key must be 32 bytes (64 hex characters)")
            except ValueError as ve:
                raise ValueError(f"Invalid key_hex: {ve}")
            name = enc_path.stem
            is_dir = 0
        else:
            raise ValueError(f"Key for label '{label}' not found in vault. Provide 'key_hex' parameter.")

        dec_bytes, extracted_label = decrypt_data(enc_data, key)
        if extracted_label != label:
            raise ValueError("Label mismatch tag")

        safe_name = Path(name).name
        if not safe_name or safe_name in (".", ".."):
            safe_name = f"{label}.restored"

        base_dest_dir = Path(dest_dir).resolve()
        if not is_safe_mcp_path(base_dest_dir):
            raise PermissionError(f"Access to destination directory '{base_dest_dir}' is restricted for MCP security.")

        dest = base_dest_dir / safe_name
        if not is_subpath(dest.parent, base_dest_dir):
            raise ValueError(f"Path traversal detected: {dest}")

        if not is_safe_mcp_path(dest):
            raise PermissionError(f"Access to destination path '{dest}' is restricted for MCP security.")

        if (dest.exists() or os.path.islink(dest)) and not force:
            raise FileExistsError(f"Destination '{dest}' already exists and force=False. Set force=True to overwrite.")

        if os.path.islink(dest):
            dest.unlink()

        if is_dir:
            dest.mkdir(parents=True, exist_ok=True)
            with tempfile.TemporaryDirectory() as tmpdir:
                tmp_zip = Path(tmpdir) / "restored.zip"
                tmp_zip.write_bytes(dec_bytes)
                extract_zip_faithful(tmp_zip, dest)
        else:
            dest.parent.mkdir(parents=True, exist_ok=True)
            tmp_file = dest.parent / f".tmp_{secrets.token_hex(6)}"
            fd = os.open(str(tmp_file), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            try:
                with open(fd, "wb", closefd=False) as fp:
                    fp.write(dec_bytes)
                    fp.flush()
                    os.fsync(fd)
                os.replace(tmp_file, dest)
            finally:
                os.close(fd)
                if tmp_file.exists():
                    try:
                        tmp_file.unlink()
                    except OSError:
                        pass

        return {
            "status": "success",
            "label": label,
            "original_name": safe_name,
            "restored_path": str(dest),
            "is_dir": bool(is_dir)
        }

    def _tool_list(self, conn_override=None):
        conn = conn_override or init_db()
        cur = conn.cursor()
        cur.execute("SELECT id, label, original_name, original_path, is_dir, size_bytes, drive_file_id, created_at FROM vault ORDER BY id DESC")
        rows = cur.fetchall()
        items = []
        for r in rows:
            items.append({
                "id": r[0],
                "label": r[1],
                "original_name": r[2],
                "original_path": r[3],
                "is_dir": bool(r[4]),
                "size_bytes": r[5],
                "drive_file_id": r[6],
                "created_at": r[7]
            })
        return {"total": len(items), "items": items}

    def _tool_download(self, item_id_or_label, dest_dir=".", force=False, conn_override=None):
        conn = conn_override or init_db()
        cur = conn.cursor()
        if isinstance(item_id_or_label, int) or str(item_id_or_label).isdigit():
            cur.execute("SELECT id, label, original_name, original_path, is_dir, enc_key, drive_file_id FROM vault WHERE id = ?", (int(item_id_or_label),))
        else:
            cur.execute("SELECT id, label, original_name, original_path, is_dir, enc_key, drive_file_id FROM vault WHERE label = ? OR original_name = ?", (str(item_id_or_label), str(item_id_or_label)))

        row = cur.fetchone()
        if not row:
            raise ValueError(f"Item '{item_id_or_label}' not found in vault.")

        item_id, label, name, original_path, is_dir, key_hex, drive_file_id = row
        key = bytes.fromhex(key_hex)

        safe_name = Path(name).name
        if not safe_name or safe_name in (".", ".."):
            safe_name = f"{label}.restored"

        base_dest_dir = Path(dest_dir).resolve()
        if not is_safe_mcp_path(base_dest_dir):
            raise PermissionError(f"Access to destination directory '{base_dest_dir}' is restricted for MCP security.")

        dest = base_dest_dir / safe_name
        if not is_subpath(dest.parent, base_dest_dir):
