MAGIC_GDE = b"GDE1"
MAGIC_EGD = b"EGD1"  # backwards compatibility
DB_DIR = Path.home() / ".config" / "gde"
LEGACY_DB = Path.home() / ".config" / "egd" / "vault.db"
DB_PATH = DB_DIR / "vault.db"


def init_db():
    DB_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(DB_DIR, 0o700)

    # Migrate from legacy egd path if needed
    if not DB_PATH.exists() and LEGACY_DB.exists():
        shutil.copy2(LEGACY_DB, DB_PATH)

    conn = sqlite3.connect(DB_PATH)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS vault (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            label TEXT UNIQUE NOT NULL,
            original_name TEXT NOT NULL,
            original_path TEXT NOT NULL,
            is_dir INTEGER NOT NULL,
            size_bytes INTEGER NOT NULL,
            enc_key TEXT NOT NULL,
            drive_file_id TEXT,
            created_at TEXT NOT NULL
        )
    """)
    conn.commit()
    os.chmod(DB_PATH, 0o600)
    return conn


class GDriveMCP:
    """Communicate with @piotr-agier/google-drive-mcp via stdio JSON-RPC."""

    def __init__(self):
        self.proc = None

    def start(self):
        try:
            self.proc = subprocess.Popen(
                ["npx", "-y", "@piotr-agier/google-drive-mcp"],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1
            )
            init_res = self._send({
                "jsonrpc": "2.0",
                "id": 1,
                "method": "initialize",
                "params": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {},
                    "clientInfo": {"name": "gde-cli", "version": "1.1.0"}
                }
            })
            if "error" in init_res:
                raise RuntimeError(f"MCP init failed: {init_res['error']}")
            self.proc.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
            self.proc.stdin.flush()
        except FileNotFoundError:
            raise RuntimeError("Command 'npx' tidak ditemukan. Pastikan Node.js terinstall.")

    def _send(self, req):
        req_id = req.get("id")
        self.proc.stdin.write(json.dumps(req) + "\n")
        self.proc.stdin.flush()
        while True:
            line = self.proc.stdout.readline()
            if not line:
                err = ""
                if self.proc.stderr:
                    try:
                        err = self.proc.stderr.read()
                    except Exception:
                        pass
                raise RuntimeError(f"MCP server closed: {err}")
            line = line.strip()
            if not line:
                continue
            try:
                data = json.loads(line)
            except json.JSONDecodeError:
                # Skip non-JSON output lines (e.g. server stdout logs)
                continue
            # If request specified id, match response id
            if req_id is not None and data.get("id") != req_id:
                continue
            return data

    def call_tool(self, tool_name, arguments):
        req = {
            "jsonrpc": "2.0",
            "id": secrets.randbelow(1000000),
            "method": "tools/call",
            "params": {
                "name": tool_name,
                "arguments": arguments
            }
        }
        resp = self._send(req)
        if "error" in resp:
            raise RuntimeError(f"RPC Error: {resp['error']}")
        result = resp.get("result", {})
        if result.get("isError"):
            msg = "".join(c.get("text", "") for c in result.get("content", []))
            raise RuntimeError(f"Tool Error: {msg}")
        return result

    def upload_file(self, local_path, remote_name):
        res = self.call_tool("uploadFile", {
            "localPath": str(Path(local_path).resolve()),
            "name": remote_name
        })
        text_out = "".join(c.get("text", "") for c in res.get("content", []))
        try:
            data = json.loads(text_out)
            file_id = data.get("fileId") or data.get("id")
            if file_id:
                return str(file_id)
        except Exception:
            pass
        import re
        m = re.search(r"(?:fileId|id)['\"]?:\s*['\"]([^'\"]+)['\"]", text_out, re.IGNORECASE)
        if m:
            return m.group(1)
        raise RuntimeError(f"Gagal mengambil fileId dari response Google Drive MCP: {text_out[:200]}")

    def download_file(self, file_id, local_path):
        self.call_tool("downloadFile", {
            "fileId": file_id,
            "localPath": str(Path(local_path).resolve()),
            "overwrite": True
        })

    def close(self):
        if self.proc:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=2)
            except Exception:
                pass


def compress_directory(src_dir, out_zip):
    """Compress directory preserving empty folders and file permissions."""
    src = Path(src_dir).resolve()
    with zipfile.ZipFile(out_zip, "w", zipfile.ZIP_DEFLATED) as zf:
        for root, dirs, files in os.walk(src):
            root_p = Path(root)
            for d in dirs:
                dir_p = root_p / d
                rel_p = dir_p.relative_to(src).as_posix() + "/"
                zinfo = zipfile.ZipInfo(rel_p)
                mode = dir_p.stat().st_mode
                zinfo.external_attr = (mode & 0xFFFF) << 16
                zf.writestr(zinfo, b"")
            for f in files:
                full_p = root_p / f
                rel_p = full_p.relative_to(src).as_posix()
                mode = full_p.stat().st_mode
                with open(full_p, "rb") as fp:
                    data = fp.read()
                zinfo = zipfile.ZipInfo(rel_p)
                zinfo.external_attr = (mode & 0xFFFF) << 16
                zinfo.compress_type = zipfile.ZIP_DEFLATED
                zf.writestr(zinfo, data)


def extract_zip_faithful(zip_path, dest_dir):
    """Extract zip preserving directory hierarchy and POSIX file permissions."""
    dest = Path(dest_dir).resolve()
    dest.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(zip_path, "r") as zf:
        for member in zf.infolist():
            extracted = Path(zf.extract(member, dest))
            perm = (member.external_attr >> 16) & 0o777
            if perm:
                try:
                    os.chmod(extracted, perm)
                except Exception:
                    pass


def encrypt_data(raw_bytes, label):
    """
    ChaCha20-Poly1305 AEAD cipher (IETF RFC 8439).
    Per-file 256-bit unique key + 96-bit nonce.
    Format: MAGIC(4) + label_len(1) + label(N) + nonce(12) + ciphertext + tag(16)
    AAD = label (tamper protection for label matching).
    """
    key = secrets.token_bytes(32)
    nonce = secrets.token_bytes(12)
    cipher = ChaCha20Poly1305(key)
    label_bytes = label.encode("utf-8")
    ct = cipher.encrypt(nonce, raw_bytes, associated_data=label_bytes)

    header = bytearray()
    header.extend(MAGIC_GDE)
    header.append(len(label_bytes))
    header.extend(label_bytes)
    header.extend(nonce)
    return bytes(header) + ct, key


def decrypt_data(enc_bytes, key):
    """Decrypt and verify integrity via Poly1305 auth tag."""
    if len(enc_bytes) < 4 + 1 + 12 + 16:
        raise ValueError("File terenkripsi tidak valid: ukuran terlalu pendek.")
    magic = enc_bytes[:4]
    if magic not in (MAGIC_GDE, MAGIC_EGD):
        raise ValueError("Header tidak valid: bukan file GDE/EGD terenkripsi.")

    label_len = enc_bytes[4]
    offset = 5
    label = enc_bytes[offset:offset + label_len].decode("utf-8")
    offset += label_len
    nonce = enc_bytes[offset:offset + 12]
    offset += 12
    ct = enc_bytes[offset:]

    cipher = ChaCha20Poly1305(key)
    return cipher.decrypt(nonce, ct, associated_data=label.encode("utf-8")), label


def confirm_overwrite(dest_path):
    """Prompt user if destination already exists."""
    if not dest_path.exists():
        return True
    if not sys.stdin.isatty():
        return True
    prompt = f"{C.YELLOW}[!]{C.RESET} Target '{C.BOLD}{dest_path}{C.RESET}' sudah ada. Timpa? [y/N]: "
    ans = input(prompt).strip().lower()
    return ans in ("y", "yes")


def cmd_encrypt(path_str, local_only=False):
    target = Path(path_str).expanduser().resolve()
    if not target.exists():
        log_err(f"Path '{target}' tidak ditemukan.")
        sys.exit(1)

    conn = init_db()
    label = f"gde_{secrets.token_hex(8)}"
    is_dir = 1 if target.is_dir() else 0
    size_bytes = sum(f.stat().st_size for f in target.glob("**/*") if f.is_file()) if is_dir else target.stat().st_size

    log_info(f"Target      : {C.BOLD}{target.name}{C.RESET} ({C.MAGENTA + 'Folder' if is_dir else C.CYAN + 'File'}{C.RESET})")
    log_info(f"Ukuran asli : {C.YELLOW}{size_bytes / 1024:.2f} KB{C.RESET}")
    log_info(f"Label file  : {C.GREEN}{label}{C.RESET}")

    with tempfile.TemporaryDirectory() as tmpdir:
        tmp = Path(tmpdir)
        temp_enc = tmp / f"{label}.enc"

        if is_dir:
            log_info(f"Target adalah {C.MAGENTA}folder{C.RESET} -> Kompres ke ZIP...")
            zip_path = tmp / "data.zip"
            compress_directory(target, zip_path)
            with open(zip_path, "rb") as f:
                raw_bytes = f.read()
        else:
            log_info(f"Target adalah {C.CYAN}file{C.RESET} -> Enkripsi langsung {C.BOLD}tanpa ZIP{C.RESET}...")
            with open(target, "rb") as f:
                raw_bytes = f.read()

        log_info("Mengenkripsi dengan ChaCha20-Poly1305 (256-bit key unik)...")
        enc_bytes, key = encrypt_data(raw_bytes, label)
        with open(temp_enc, "wb") as f:
            f.write(enc_bytes)

        drive_file_id = None
        created_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        if local_only:
            # Mode lokal: simpan file .enc di direktori kerja saat ini
            out_enc = Path.cwd() / f"{target.name}.enc"
            if not confirm_overwrite(out_enc):
                log_warn("Dibatalkan oleh pengguna.")
                return
            shutil.copy2(temp_enc, out_enc)
            conn.execute(
                """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
                   VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                (label, target.name, str(target), is_dir, size_bytes, key.hex(), None, created_at)
            )
            conn.commit()
            log_success(f"File terenkripsi disimpan ke: {C.BOLD}{C.GREEN}{out_enc}{C.RESET}")
            log_success(f"Kunci tersimpan di vault lokal: {C.DIM}{DB_PATH}{C.RESET}")
            log_info(f"Untuk restore lokal: {C.GREEN}gde decrypt {out_enc.name}{C.RESET}")
            log_done(f"Selesai: {C.BOLD}{target.name}{C.RESET} terenkripsi lokal.")
            return

        # Mode online: upload via Google Drive MCP
        log_info("Mengunggah ke Google Drive via MCP...")
        mcp = GDriveMCP()
        upload_err = None
        try:
            mcp.start()
            drive_file_id = mcp.upload_file(temp_enc, f"{label}.enc")
            log_success(f"Berhasil upload. Drive ID: {C.GREEN}{drive_file_id}{C.RESET}")
        except Exception as e:
            upload_err = e
        finally:
            mcp.close()

        if upload_err:
            # Cegah hilangnya ciphertext: selamatkan ke disk lokal
            fallback_enc = Path.cwd() / f"{target.name}.enc"
            shutil.copy2(temp_enc, fallback_enc)
            conn.execute(
                """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
                   VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                (label, target.name, str(target), is_dir, size_bytes, key.hex(), None, created_at)
            )
            conn.commit()
            log_err(f"GDrive MCP Error: {upload_err}")
            log_warn(f"Upload gagal. File terenkripsi diamankan ke: {C.BOLD}{fallback_enc}{C.RESET}")
            log_info(f"Kunci tersimpan di vault. Untuk restore lokal: {C.GREEN}gde decrypt {fallback_enc.name}{C.RESET}")
            sys.exit(1)

        # Sukses upload online
        conn.execute(
            """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
               VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
            (label, target.name, str(target), is_dir, size_bytes, key.hex(), drive_file_id, created_at)
        )
        conn.commit()
        log_success(f"Kunci & metadata aman tersimpan di {C.DIM}{DB_PATH}{C.RESET}")
        log_done(f"Selesai: {C.BOLD}{target.name}{C.RESET} terenkripsi penuh di cloud.")


def cmd_decrypt_file(enc_path_str, dest_dir="."):
    """Decrypt a local .enc file using the key from local vault or user input."""
    enc_path = Path(enc_path_str).expanduser().resolve()
    if not enc_path.exists():
        log_err(f"File terenkripsi '{enc_path}' tidak ditemukan.")
        sys.exit(1)

    log_info(f"Membaca file terenkripsi: {C.BOLD}{enc_path.name}{C.RESET}")
    with open(enc_path, "rb") as f:
        enc_data = f.read()

    if len(enc_data) < 5:
        log_err("Format file tidak valid (terlalu pendek).")
        sys.exit(1)

    magic = enc_data[:4]
    if magic not in (MAGIC_GDE, MAGIC_EGD):
        log_err("Bukan file terenkripsi GDE/EGD.")
        sys.exit(1)

    label_len = enc_data[4]
    label = enc_data[5:5 + label_len].decode("utf-8", errors="ignore")
    log_info(f"Terdeteksi label: {C.GREEN}{label}{C.RESET}")

    conn = init_db()
    cur = conn.cursor()
    cur.execute("SELECT original_name, is_dir, enc_key FROM vault WHERE label = ?", (label,))
    row = cur.fetchone()

    if row:
        name, is_dir, key_hex = row
        key = bytes.fromhex(key_hex)
        log_info(f"Kunci ditemukan di vault untuk file: {C.BOLD}{name}{C.RESET}")
    else:
        log_warn("Kunci untuk label ini tidak ditemukan di database vault lokal.")
        key_input = input(f"{C.CYAN}Masukkan 64-karakter hex key (atau 'q' keluar): {C.RESET}").strip()
        if not key_input or key_input.lower() == "q":
            return
        try:
            key = bytes.fromhex(key_input)
            if len(key) != 32:
                raise ValueError("Panjang kunci harus 32 byte (64 hex characters)")
        except ValueError as ve:
            log_err(f"Kunci tidak valid: {ve}")
            return
        name = enc_path.stem
        is_dir = 0

    try:
        dec_bytes, extracted_label = decrypt_data(enc_data, key)
        if extracted_label != label:
            raise ValueError("Label mismatch tag")
    except InvalidTag:
        log_err("Gagal dekripsi: Kunci salah atau data telah diubah/korup (InvalidTag)!")
        sys.exit(1)
    except Exception as e:
        log_err(f"Gagal dekripsi: {e}")
        sys.exit(1)

    dest = Path(dest_dir).resolve() / name
    if not confirm_overwrite(dest):
        log_warn("Dibatalkan oleh pengguna.")
        return

    if is_dir:
        with tempfile.TemporaryDirectory() as tmpdir:
            tmp_zip = Path(tmpdir) / "restored.zip"
            tmp_zip.write_bytes(dec_bytes)
            log_info(f"Mengekstrak folder ke: {C.BOLD}{dest}{C.RESET}")
            extract_zip_faithful(tmp_zip, dest)
    else:
        log_info(f"Menulis file ke: {C.BOLD}{dest}{C.RESET}")
        dest.write_bytes(dec_bytes)

    log_done(f"Berhasil didekripsi ke: {C.BOLD}{C.GREEN}{dest}{C.RESET}")


def cmd_list():
    conn = init_db()
    cur = conn.cursor()
    cur.execute("SELECT id, label, original_name, is_dir, size_bytes, drive_file_id, created_at FROM vault ORDER BY id DESC")
    rows = cur.fetchall()

    if not rows:
        print(f"\n{C.YELLOW}[!]{C.RESET} Vault kosong. Belum ada file yang dienkripsi.\n")
        return

    print(f"\n{C.BOLD}{C.CYAN}=== DAFTAR FILE ENCRYPTED GOOGLE DRIVE (GDE) ==={C.RESET}")
    print(f"{C.BOLD}{'No':<4} {'Nama':<25} {'Tipe':<8} {'Ukuran':<12} {'GDrive ID':<20} {'Waktu'}{C.RESET}")
    print(f"{C.GRAY}{'-' * 85}{C.RESET}")
    for r in rows:
        fid, label, name, is_dir, size, drive_id, created = r
        raw_tipe = "Folder" if is_dir else "File"
        tipe_color = C.MAGENTA if is_dir else C.CYAN
        tipe_fmt = f"{tipe_color}{raw_tipe:<8}{C.RESET}"

        sz = f"{size / 1024:.1f} KB" if size < 1024 * 1024 else f"{size / (1024 * 1024):.2f} MB"
        sz_fmt = f"{C.BLUE}{sz:<12}{C.RESET}"

        raw_did = (drive_id[:17] + "...") if drive_id and len(drive_id) > 20 else (drive_id or "Lokal")
        did_color = C.GREEN if drive_id else C.YELLOW
        did_fmt = f"{did_color}{raw_did:<20}{C.RESET}"

        fid_fmt = f"{C.YELLOW}{fid:<4}{C.RESET}"
        name_fmt = f"{C.BOLD}{name[:24]:<25}{C.RESET}"

        print(f"{fid_fmt} {name_fmt} {tipe_fmt} {sz_fmt} {did_fmt} {C.DIM}{created}{C.RESET}")
    print(f"{C.GRAY}{'-' * 85}{C.RESET}")

    try:
        pilihan = input(f"\n{C.BOLD}{C.CYAN}Masukkan No file untuk download & restore{C.RESET} ({C.YELLOW}atau 'q' keluar{C.RESET}): ").strip()
        if not pilihan or pilihan.lower() == "q":
            return
        item_id = int(pilihan)
    except KeyboardInterrupt:
        print("\nDibatalkan.")
        return
    except ValueError:
        log_err("Input tidak valid: Masukkan angka nomor file.")
        return

    cmd_download(item_id)


def cmd_download(item_id_or_label, dest_dir="."):
    conn = init_db()
    cur = conn.cursor()
    if isinstance(item_id_or_label, int) or str(item_id_or_label).isdigit():
        cur.execute("SELECT id, label, original_name, original_path, is_dir, enc_key, drive_file_id FROM vault WHERE id = ?", (int(item_id_or_label),))
    else:
        cur.execute("SELECT id, label, original_name, original_path, is_dir, enc_key, drive_file_id FROM vault WHERE label = ? OR original_name = ?", (str(item_id_or_label), str(item_id_or_label)))

    row = cur.fetchone()
    if not row:
        log_err(f"Data '{item_id_or_label}' tidak ditemukan di vault.")
        return

    _, label, name, original_path, is_dir, key_hex, drive_file_id = row
    key = bytes.fromhex(key_hex)
    dest = Path(dest_dir).resolve() / name

    log_info(f"Memproses download: {C.BOLD}{name}{C.RESET} (Label: {C.GREEN}{label}{C.RESET}, Tipe: {C.MAGENTA + 'Folder' if is_dir else C.CYAN + 'File'}{C.RESET})")

    with tempfile.TemporaryDirectory() as tmpdir:
        tmp = Path(tmpdir)
        enc_file = tmp / f"{label}.enc"

        if not drive_file_id:
            # File lokal: periksa keberadaan file .enc lokal
            candidates = [
                Path.cwd() / f"{name}.enc",
                Path.cwd() / f"{label}.enc",
                Path(original_path).parent / f"{name}.enc"
            ]
            found = None
            for cand in candidates:
                if cand.exists():
                    found = cand
                    break
            if found:
                log_info(f"Menggunakan ciphertext lokal: {C.BOLD}{found}{C.RESET}")
                enc_file = found
            else:
                log_err("Item ini tersimpan lokal (tanpa ID GDrive) dan file .enc tidak ditemukan di folder saat ini.")
                log_info(f"Jalankan: {C.GREEN}gde decrypt <path/ke/{name}.enc>{C.RESET}")
                return
        else:
            log_info(f"Mengunduh dari GDrive (ID: {C.GREEN}{drive_file_id}{C.RESET}) via MCP...")
            mcp = GDriveMCP()
            try:
                mcp.start()
                mcp.download_file(drive_file_id, enc_file)
            finally:
                mcp.close()

        if not enc_file.exists():
            log_err("Gagal: File hasil download tidak ditemukan.")
            return

        log_info("Mendekripsi file dengan kunci dari database lokal...")
        with open(enc_file, "rb") as f:
            enc_data = f.read()

        try:
            dec_bytes, extracted_label = decrypt_data(enc_data, key)
            if extracted_label != label:
                raise ValueError("Mismatch label tag")
        except InvalidTag:
            log_err("Gagal dekripsi: Tag otentikasi tidak valid (data korup atau kunci salah)!")
            return
        except Exception as e:
            log_err(f"Gagal dekripsi: {e}")
            return

        if not confirm_overwrite(dest):
            log_warn("Dibatalkan oleh pengguna.")
            return

        if is_dir:
            log_info(f"Folder terdeteksi -> Mengekstrak ZIP ke: {C.BOLD}{dest}{C.RESET}")
            decrypted_zip = tmp / "restored.zip"
            decrypted_zip.write_bytes(dec_bytes)
            extract_zip_faithful(decrypted_zip, dest)
        else:
            log_info(f"File tunggal terdeteksi -> Menulis langsung (tanpa ZIP) ke: {C.BOLD}{dest}{C.RESET}")
            dest.write_bytes(dec_bytes)

        log_done(f"Berhasil di-restore ke: {C.BOLD}{C.GREEN}{dest}{C.RESET}")


def cmd_export_keys(out_path=None):
    """Export vault database to a backup JSON file."""
    conn = init_db()
    cur = conn.cursor()
    cur.execute("SELECT id, label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at FROM vault")
    rows = cur.fetchall()

    data = []
    for r in rows:
        data.append({
            "id": r[0],
            "label": r[1],
            "original_name": r[2],
            "original_path": r[3],
            "is_dir": r[4],
            "size_bytes": r[5],
            "enc_key": r[6],
            "drive_file_id": r[7],
            "created_at": r[8]
        })

    if not out_path:
        out_path = Path.home() / ".config" / "gde" / f"vault-backup-{datetime.now().strftime('%Y%m%d%H%M%S')}.json"
    else:
        out_path = Path(out_path).resolve()

    with open(out_path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
    os.chmod(out_path, 0o600)
    log_done(f"Vault berhasil di-export ke: {C.BOLD}{C.GREEN}{out_path}{C.RESET} ({len(data)} entri)")
    log_warn("PENTING: File backup berisi kunci rahasia. Simpan di tempat yang sangat aman!")


def cmd_import_keys(in_path):
    """Import keys from a backup JSON file."""
    path = Path(in_path).expanduser().resolve()
    if not path.exists():
        log_err(f"File backup '{path}' tidak ditemukan.")
        sys.exit(1)

    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)

    if not isinstance(data, list):
        log_err("Format backup JSON tidak valid.")
        sys.exit(1)

    conn = init_db()
    count = 0
    for item in data:
        cur = conn.cursor()
        cur.execute("SELECT id FROM vault WHERE label = ?", (item["label"],))
        if not cur.fetchone():
            conn.execute(
                """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
                   VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                (item["label"], item["original_name"], item["original_path"], item["is_dir"],
                 item["size_bytes"], item["enc_key"], item.get("drive_file_id"), item["created_at"])
            )
            count += 1
    conn.commit()
    log_done(f"Berhasil mengimpor {C.BOLD}{count}{C.RESET} kunci baru ke vault.")


def self_test():
    """Deterministic verification for single file, directory, and tamper detection."""
    log_info("Menjalankan self-test GDE...")
    with tempfile.TemporaryDirectory() as tmpdir:
        tmp = Path(tmpdir)

        # 1. Test Single File (Direct without zip)
        file_path = tmp / "document.md"
        test_content = b"# Top Secret Notes\nNo zip overhead for single files!"
        file_path.write_bytes(test_content)

        label_file = "gde_testfile01"
        enc_file, key_file = encrypt_data(file_path.read_bytes(), label_file)
        if enc_file[:4] != MAGIC_GDE:
            raise RuntimeError("Magic header mismatch on single file")

        # Decrypt single file
        dec_file, lbl = decrypt_data(enc_file, key_file)
        if lbl != label_file:
            raise RuntimeError("Label mismatch on single file")
        if dec_file != test_content:
            raise RuntimeError("Decrypted content mismatch on single file")

        # 2. Test Directory with faithful permissions & empty dir
        folder_path = tmp / "my_folder"
        folder_path.mkdir()
        empty_sub = folder_path / "empty_sub"
        empty_sub.mkdir()
        script_file = folder_path / "script.sh"
        script_file.write_text("#!/bin/sh\necho test\n")
        script_file.chmod(0o755)

        zip_p = tmp / "folder.zip"
        compress_directory(folder_path, zip_p)
        if not zip_p.exists():
            raise RuntimeError("Folder zip compression failed")

        label_dir = "gde_testdir02"
        enc_dir, key_dir = encrypt_data(zip_p.read_bytes(), label_dir)
        dec_dir, lbl_dir = decrypt_data(enc_dir, key_dir)
        if lbl_dir != label_dir:
            raise RuntimeError("Label mismatch on directory")
        if dec_dir != zip_p.read_bytes():
            raise RuntimeError("Decrypted zip bytes mismatch")

        restore_dir = tmp / "restored_folder"
        restore_zip = tmp / "restored.zip"
        restore_zip.write_bytes(dec_dir)
        extract_zip_faithful(restore_zip, restore_dir)

        if not (restore_dir / "empty_sub").is_dir():
            raise RuntimeError("Empty subfolder not preserved in zip restore")
        restored_script = restore_dir / "script.sh"
        if not restored_script.is_file():
            raise RuntimeError("script.sh missing in restored folder")
        restored_mode = stat.S_IMODE(restored_script.stat().st_mode)
        if restored_mode != 0o755:
            raise RuntimeError(f"Permissions not preserved: expected 0o755, got {oct(restored_mode)}")

        # 3. Tamper test: Corrupted ciphertext MUST fail decryption
        tampered_cipher = bytearray(enc_file)
        tampered_cipher[-1] ^= 0x01
        try:
            decrypt_data(bytes(tampered_cipher), key_file)
        except Exception:
            pass  # Expected to fail
        else:
            raise RuntimeError("Tamper detection failed! Corrupted ciphertext was accepted.")

        # 4. Tamper test: Tampered label in header MUST fail decryption
        tampered_header = bytearray(enc_file)
        tampered_header[5] ^= 0x01  # Flip one byte in label
        try:
            decrypt_data(bytes(tampered_header), key_file)
        except Exception:
            pass  # Expected to fail
        else:
            raise RuntimeError("Tamper detection failed! Tampered label was accepted.")

        # 5. Wrong key MUST fail decryption
        wrong_key = secrets.token_bytes(32)
        try:
            decrypt_data(enc_file, wrong_key)
        except Exception:
            pass  # Expected to fail
        else:
            raise RuntimeError("Key verification failed! Wrong key was accepted.")

    log_done("Self-test lolos:")
    print(f"    {C.GREEN}•{C.RESET} Single file (direct encrypt, no zip): {C.GREEN}OK{C.RESET}")
    print(f"    {C.GREEN}•{C.RESET} Folder (empty dirs + permissions preserved): {C.GREEN}OK{C.RESET}")
    print(f"    {C.GREEN}•{C.RESET} ChaCha20-Poly1305 Ciphertext Tamper check: {C.GREEN}OK{C.RESET}")
    print(f"    {C.GREEN}•{C.RESET} AAD Label Tamper check: {C.GREEN}OK{C.RESET}")
    print(f"    {C.GREEN}•{C.RESET} Wrong Key Rejection: {C.GREEN}OK{C.RESET}")


