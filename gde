def get_saved_lang():
    env_lang = os.environ.get("GDE_LANG", "").lower().strip()
    if env_lang in ("id", "en"):
        return env_lang
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                data = json.load(f)
                lang = data.get("lang", "").lower().strip()
                if lang in ("id", "en"):
                    return lang
        except Exception:
            pass
    return "id"


CURRENT_LANG = get_saved_lang()


def set_current_lang(lang):
    global CURRENT_LANG
    lang_clean = lang.lower().strip()
    if lang_clean in ("id", "en"):
        CURRENT_LANG = lang_clean


def t(key, **kwargs):
    dic = T.get(CURRENT_LANG, T["id"])
    pattern = dic.get(key) or T["id"].get(key, key)
    if kwargs:
        return pattern.format(**kwargs)
    return pattern


def init_db(custom_path=None):
    path = Path(custom_path) if custom_path else DB_PATH
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(path.parent, 0o700)
    except OSError as e:
        log_warn(f"Tidak dapat menerapkan mode 0700 pada direktori vault '{path.parent}': {e}")

    # Migrate from legacy egd path if needed
    if not custom_path and not DB_PATH.exists() and LEGACY_DB.exists():
        shutil.copy2(LEGACY_DB, DB_PATH)

    conn = sqlite3.connect(path)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS vault (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            label TEXT UNIQUE NOT NULL,
            original_name TEXT NOT NULL,
            original_path TEXT NOT NULL,
            is_dir INTEGER NOT NULL,
            size_bytes INTEGER NOT NULL,
            enc_key TEXT NOT NULL,
            drive_file_id TEXT,
            created_at TEXT NOT NULL
        )
    """)
    conn.commit()
    try:
        os.chmod(path, 0o600)
    except OSError as e:
        log_warn(f"Tidak dapat menerapkan mode 0600 pada database vault '{path}': {e}")
    return conn


def is_subpath(child, parent):
    """Check if child path resolves safely within parent path."""
    try:
        Path(child).resolve().relative_to(Path(parent).resolve())
        return True
    except ValueError:
        return False


DANGEROUS_SYSTEM_PATHS = (
    Path("/etc"),
    Path("/proc"),
    Path("/sys"),
    Path("/dev"),
    Path("/boot"),
    Path("/root"),
    Path("/var/log"),
)


def is_safe_mcp_path(path: Union[str, Path]) -> bool:
    """Validate that path does not access dangerous system roots and conforms to optional whitelists."""
    try:
        resolved = Path(path).expanduser().resolve()
    except Exception:
        return False

    for dangerous in DANGEROUS_SYSTEM_PATHS:
        try:
            if resolved == dangerous or is_subpath(resolved, dangerous):
                return False
        except Exception:
            return False

    allowed_roots_env = os.environ.get("GDE_ALLOWED_ROOTS")
    if allowed_roots_env:
        allowed_roots = [Path(p.strip()).expanduser().resolve() for p in allowed_roots_env.split(":") if p.strip()]
        if allowed_roots and not any(resolved == r or is_subpath(resolved, r) for r in allowed_roots):
            return False

    return True


def atomic_copy_file(src_path, dest_path, mode=0o600):
    """Copy a file to dest_path atomically without overwriting existing hard links."""
    dest = Path(dest_path).resolve()
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = dest.parent / f".tmp_cp_{secrets.token_hex(6)}"

    with open(src_path, "rb") as s, open(tmp_path, "wb") as d:
        d.write(s.read())
        d.flush()
        os.fsync(d.fileno())

    try:
        os.chmod(tmp_path, mode)
    except OSError:
        pass

    # os.replace unlinks the old directory entry and links the new inode, breaking any hard links safely
    os.replace(tmp_path, dest)


def parse_duration(time_str: str) -> int:
    """
    Parse a duration string into total seconds.
    Supports units:
      s: detik (seconds)
      m: menit (minutes)
      h: jam (hours)
      d: hari (days)
      y: tahun (years, 365 days)
    Supports single or compound expressions (e.g. '30s', '24h', '7d', '1y', '1d12h').
    """
    s = time_str.strip().lower()
    if not s:
        raise ValueError("Durasi waktu (--time) tidak boleh kosong.")

    units = {
        "s": 1,
        "m": 60,
        "h": 3600,
        "d": 86400,
        "y": 365 * 86400,
    }

    matches = re.findall(r"(\d+)\s*([smhdy])", s)
    if not matches:
        raise ValueError(
            f"Format durasi waktu '{time_str}' tidak valid. Gunakan format seperti: 30s, 10m, 24h, 7d, 1y"
        )

    consumed = "".join(f"{num}{unit}" for num, unit in matches)
    cleaned = re.sub(r"\s+", "", s)
    if consumed != cleaned:
        raise ValueError(
            f"Format durasi waktu '{time_str}' tidak valid. Satuan yang didukung: s (detik), m (menit), h (jam), d (hari), y (tahun)."
        )

    total_seconds = sum(int(num) * units[unit] for num, unit in matches)
    if total_seconds <= 0:
        raise ValueError("Durasi waktu (--time) harus lebih besar dari 0.")

    return total_seconds


def format_duration(seconds: int, lang=None) -> str:
    """Format total seconds into a readable string (e.g. '24 jam' or '24 hours')."""
    l = lang or CURRENT_LANG
    if seconds < 60:
        return f"{seconds} detik" if l == "id" else f"{seconds} seconds"
    parts = []
    years, rem = divmod(seconds, 365 * 86400)
    days, rem = divmod(rem, 86400)
    hours, rem = divmod(rem, 3600)
    minutes, sec = divmod(rem, 60)

    if l == "id":
        if years:
            parts.append(f"{years} tahun")
        if days:
            parts.append(f"{days} hari")
        if hours:
            parts.append(f"{hours} jam")
        if minutes:
            parts.append(f"{minutes} menit")
        if sec:
            parts.append(f"{sec} detik")
    else:
        if years:
            parts.append(f"{years} year" if years == 1 else f"{years} years")
        if days:
            parts.append(f"{days} day" if days == 1 else f"{days} days")
        if hours:
            parts.append(f"{hours} hour" if hours == 1 else f"{hours} hours")
        if minutes:
            parts.append(f"{minutes} minute" if minutes == 1 else f"{minutes} minutes")
        if sec:
            parts.append(f"{sec} second" if sec == 1 else f"{sec} seconds")

    fallback = f"{seconds} detik" if l == "id" else f"{seconds} seconds"
    return " ".join(parts) if parts else fallback


class GDriveMCP:
    """Communicate with @piotr-agier/google-drive-mcp via stdio JSON-RPC."""

    def __init__(self, timeout=60):
        self.proc = None
        self.timeout = timeout
        self.stderr_buf = []
        self._stdout_queue = queue.Queue()
        self._threads = []

    def _drain_stdout(self):
        try:
            for line in iter(self.proc.stdout.readline, ""):
                if not line:
                    break
                self._stdout_queue.put(line)
        except Exception:
            pass

    def _drain_stderr(self):
        try:
            for line in iter(self.proc.stderr.readline, ""):
                if not line:
                    break
                self.stderr_buf.append(line)
                if len(self.stderr_buf) > 100:
                    self.stderr_buf.pop(0)
        except Exception:
            pass

    def start(self):
        try:
            self.proc = subprocess.Popen(
                ["npx", "-y", "@piotr-agier/google-drive-mcp"],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1
            )
            t_out = threading.Thread(target=self._drain_stdout, daemon=True)
            t_err = threading.Thread(target=self._drain_stderr, daemon=True)
            t_out.start()
            t_err.start()
            self._threads = [t_out, t_err]

            init_res = self._send({
                "jsonrpc": "2.0",
                "id": 1,
                "method": "initialize",
                "params": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {},
                    "clientInfo": {"name": "gde-cli", "version": VERSION}
                }
            })
            if "error" in init_res:
                raise RuntimeError(f"MCP init failed: {init_res['error']}")
            self.proc.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
            self.proc.stdin.flush()
        except FileNotFoundError:
            raise RuntimeError("Command 'npx' tidak ditemukan. Pastikan Node.js terinstall.")

    def _send(self, req):
        req_id = req.get("id")
        self.proc.stdin.write(json.dumps(req) + "\n")
        self.proc.stdin.flush()
        deadline = datetime.now().timestamp() + self.timeout

        while True:
            remaining = deadline - datetime.now().timestamp()
            if remaining <= 0:
                raise TimeoutError(f"Timeout menunggu response MCP server ({self.timeout} detik).")

            try:
                line = self._stdout_queue.get(timeout=min(remaining, 1.0))
            except queue.Empty:
                if self.proc.poll() is not None:
                    err = "".join(self.stderr_buf)
                    raise RuntimeError(f"MCP server berhenti mendadak (exit code {self.proc.returncode}): {err}")
                continue

            line = line.strip()
            if not line:
                continue

            try:
                data = json.loads(line)
            except json.JSONDecodeError:
                continue

            if req_id is not None and data.get("id") != req_id:
                continue

            return data

    def call_tool(self, tool_name, arguments):
        req = {
            "jsonrpc": "2.0",
            "id": secrets.randbelow(1000000),
            "method": "tools/call",
            "params": {
                "name": tool_name,
                "arguments": arguments
            }
        }
        resp = self._send(req)
        if "error" in resp:
            raise RuntimeError(f"RPC Error: {resp['error']}")
        result = resp.get("result", {})
        if result.get("isError"):
            msg = "".join(c.get("text", "") for c in result.get("content", []))
            raise RuntimeError(f"Tool Error: {msg}")
        return result

    def delete_file(self, file_id):
        self.call_tool("deleteItem", {
            "itemId": str(file_id)
        })

    def upload_file(self, local_path, remote_name):
        res = self.call_tool("uploadFile", {
            "localPath": str(Path(local_path).resolve()),
            "name": remote_name
        })
        text_out = "".join(c.get("text", "") for c in res.get("content", []))
        try:
            data = json.loads(text_out)
            file_id = data.get("fileId") or data.get("id")
            if file_id:
                return str(file_id)
        except Exception:
            pass

        patterns = [
            r"(?:fileId|id)\s*[:=]\s*['\"]?([a-zA-Z0-9_\-]+)",
            r"drive\.google\.com/file/d/([a-zA-Z0-9_\-]+)",
            r"(?:file/d/|open\?id=)([a-zA-Z0-9_\-]+)",
            r"^ID:\s*(\S+)"
        ]
        for pat in patterns:
            m = re.search(pat, text_out, re.IGNORECASE | re.MULTILINE)
            if m:
                return m.group(1).strip("'\"")

        raise RuntimeError(f"Gagal mengambil fileId dari response Google Drive MCP: {text_out[:200]}")

    def download_file(self, file_id, local_path):
        self.call_tool("downloadFile", {
            "fileId": file_id,
            "localPath": str(Path(local_path).resolve()),
            "overwrite": True
        })

    def close(self):
        if self.proc:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=2)
            except Exception:
                pass


def compress_directory(src_dir, out_zip, on_file=None):
    """Compress directory preserving empty folders, all symlinks, and file permissions. Safely skips FIFOs."""
    src = Path(src_dir).resolve()
    unreadable = []
    special_files = []

    def on_walk_err(err):
        unreadable.append((err.filename, str(err)))

    with zipfile.ZipFile(out_zip, "w", zipfile.ZIP_DEFLATED) as zf:
        for root, dirs, files in os.walk(src, followlinks=False, onerror=on_walk_err):
            root_p = Path(root)

            for d in dirs:
                dir_p = root_p / d
                rel_p = dir_p.relative_to(src).as_posix()
                if os.path.islink(dir_p):
                    link_target = os.readlink(dir_p)
                    zinfo = zipfile.ZipInfo(rel_p)
                    zinfo.create_system = 3  # Unix
                    zinfo.external_attr = (stat.S_IFLNK | 0o777) << 16
                    zf.writestr(zinfo, link_target)
                else:
                    zinfo = zipfile.ZipInfo(f"{rel_p}/")
                    zinfo.create_system = 3  # Unix
                    try:
                        mode = dir_p.stat().st_mode
                        zinfo.external_attr = (mode & 0xFFFF) << 16
                    except OSError:
                        zinfo.external_attr = (stat.S_IFDIR | 0o755) << 16
                    zf.writestr(zinfo, b"")

            for f in files:
                if on_file:
                    on_file()
                full_p = root_p / f
                rel_p = full_p.relative_to(src).as_posix()

                try:
                    st = os.lstat(full_p)
                except OSError as e:
                    unreadable.append((str(full_p), str(e)))
                    continue

                if stat.S_ISLNK(st.st_mode):
                    link_target = os.readlink(full_p)
                    zinfo = zipfile.ZipInfo(rel_p)
                    zinfo.create_system = 3  # Unix
                    zinfo.external_attr = (stat.S_IFLNK | 0o777) << 16
                    zf.writestr(zinfo, link_target)
                elif stat.S_ISREG(st.st_mode):
                    try:
                        with open(full_p, "rb") as fp:
                            data = fp.read()
                    except OSError as e:
                        unreadable.append((str(full_p), str(e)))
                        continue
                    zinfo = zipfile.ZipInfo(rel_p)
                    zinfo.create_system = 3  # Unix
                    zinfo.external_attr = (st.st_mode & 0xFFFF) << 16
                    zinfo.compress_type = zipfile.ZIP_DEFLATED
                    zf.writestr(zinfo, data)
                else:
                    special_files.append(str(full_p))

    return unreadable, special_files


def extract_zip_faithful(zip_path, dest_dir):
    """Extract zip with Zip Slip protection, hard link collision defense, and POSIX permissions."""
    dest = Path(dest_dir).resolve()
    dest.mkdir(parents=True, exist_ok=True)
    dir_perms = []

    with zipfile.ZipFile(zip_path, "r") as zf:
        for member in zf.infolist():
            # 1. Tolak nama entri yang memakai path traversal
            if member.filename.startswith("/") or ".." in member.filename.split("/"):
                log_warn(f"Entri arsip berbahaya ditolak (Path Traversal attempt): {member.filename}")
                continue

            target_path = dest / member.filename
            perm = (member.external_attr >> 16) & 0xFFFF
            is_symlink = stat.S_ISLNK(perm)
            is_dir = member.filename.endswith("/")

            if is_symlink:
                # Lokasi inode symlink harus berada di dalam dest
                if not is_subpath(target_path.parent, dest):
                    log_warn(f"Lokasi symlink di luar batas ditolak: {member.filename}")
                    continue

                link_target = zf.read(member).decode("utf-8")
                target_path.parent.mkdir(parents=True, exist_ok=True)
                if target_path.exists() or os.path.islink(target_path):
                    target_path.unlink()
                try:
                    os.symlink(link_target, target_path)
                except OSError:
                    pass
            elif is_dir:
                if not is_subpath(target_path, dest):
                    log_warn(f"Direktori di luar batas ditolak: {member.filename}")
                    continue
                target_path.mkdir(parents=True, exist_ok=True)
                dir_perms.append((target_path, perm & 0o777))
            else:
                # File biasa:
                # Hapus symlink lama pada target_path jika entri sebelumnya adalah symlink
                if os.path.islink(target_path):
                    target_path.unlink()

                # Pastikan target_path dan parent-nya tidak tembus keluar batas
                if not is_subpath(target_path.parent, dest) or not is_subpath(target_path, dest):
                    log_warn(f"Penulisan file melewati symlink ditolak: {member.filename}")
                    continue

                target_path.parent.mkdir(parents=True, exist_ok=True)
                file_data = zf.read(member)

                # Hard link defense: ekstrak ke file sementara baru, lalu ganti secara atomik dengan os.replace
                tmp_out = target_path.parent / f".tmp_ext_{secrets.token_hex(6)}"
                file_perm = (perm & 0o777) or 0o600
                fd = os.open(str(tmp_out), os.O_WRONLY | os.O_CREAT | os.O_EXCL, file_perm)
                try:
                    with open(fd, "wb", closefd=False) as fp:
                        fp.write(file_data)
                        fp.flush()
                        os.fsync(fd)
                    os.replace(tmp_out, target_path)
                finally:
                    os.close(fd)
                    if tmp_out.exists():
                        try:
                            tmp_out.unlink()
                        except OSError:
                            pass

                if file_perm:
                    try:
                        os.chmod(target_path, file_perm)
                    except Exception:
                        pass

    # Terapkan izin direktori setelah seluruh file diekstrak (dari path terdalam)
    dir_perms.sort(key=lambda x: len(x[0].parts), reverse=True)
    for dpath, dperm in dir_perms:
        if dperm:
            try:
                os.chmod(dpath, dperm)
            except Exception:
                pass


def encrypt_data(raw_bytes, label):
    """
    ChaCha20-Poly1305 AEAD cipher (IETF RFC 8439).
    Per-file 256-bit unique key + 96-bit nonce.
    Format: MAGIC(4) + label_len(1) + label(N) + nonce(12) + ciphertext + tag(16)
    AAD = label (tamper protection for label matching).
    """
    key = secrets.token_bytes(32)
    nonce = secrets.token_bytes(12)
    cipher = ChaCha20Poly1305(key)
    label_bytes = label.encode("utf-8")
    ct = cipher.encrypt(nonce, raw_bytes, associated_data=label_bytes)

    header = bytearray()
    header.extend(MAGIC_GDE)
    header.append(len(label_bytes))
    header.extend(label_bytes)
    header.extend(nonce)
    return bytes(header) + ct, key


def decrypt_data(enc_bytes, key):
    """Decrypt and verify integrity via Poly1305 auth tag."""
    if len(enc_bytes) < 4 + 1 + 12 + 16:
        raise ValueError("File terenkripsi tidak valid: ukuran terlalu pendek.")
    magic = enc_bytes[:4]
    if magic not in (MAGIC_GDE, MAGIC_EGD):
        raise ValueError("Header tidak valid: bukan file GDE/EGD terenkripsi.")

    label_len = enc_bytes[4]
    offset = 5
    label = enc_bytes[offset:offset + label_len].decode("utf-8")
    offset += label_len
    nonce = enc_bytes[offset:offset + 12]
    offset += 12
    ct = enc_bytes[offset:]

    cipher = ChaCha20Poly1305(key)
    return cipher.decrypt(nonce, ct, associated_data=label.encode("utf-8")), label


def confirm_overwrite(dest_path, force=False):
    """Check overwrite. Prevents silent overwrite when running non-interactively."""
    if force:
        return True
    if not dest_path.exists() and not os.path.islink(dest_path):
        return True

    if not sys.stdin.isatty():
        log_err(t("overwrite_noninteractive", dest=dest_path))
        return False

    prompt = f"{C.YELLOW}[!]{C.RESET} {t('overwrite_prompt', dest=f'{C.BOLD}{dest_path}{C.RESET}')}"
    ans = input(prompt).strip().lower()
    return ans in ("y", "yes")


def cmd_encrypt(path_str, local_only=False, force=False, allow_partial=False, exit_on_error=True, output_filename=None, conn_override=None):
    target = Path(path_str).expanduser().resolve()
    if not target.exists() and not os.path.islink(target):
        log_err(t("target_not_found", target=target))
        if exit_on_error:
            sys.exit(1)
        return 1

    try:
        st = os.lstat(target)
    except OSError as e:
        log_err(t("stat_error", target=target, err=e))
        if exit_on_error:
            sys.exit(1)
        return 1

    # Bug #3: Tolak file khusus (FIFO/socket/device) pada input langsung
    if stat.S_ISFIFO(st.st_mode) or stat.S_ISSOCK(st.st_mode) or stat.S_ISCHR(st.st_mode) or stat.S_ISBLK(st.st_mode):
        log_err(t("special_file_err", name=target.name))
        if exit_on_error:
            sys.exit(1)
        return 1

    is_dir = 1 if stat.S_ISDIR(st.st_mode) and not os.path.islink(target) else 0
    if not is_dir and not stat.S_ISREG(st.st_mode) and not os.path.islink(target):
        log_err(t("invalid_target_type", name=target.name))
        if exit_on_error:
            sys.exit(1)
        return 1

    conn = conn_override or init_db()
    label = f"gde_{secrets.token_hex(8)}"

    if is_dir:
        size_bytes = sum(f.stat().st_size for f in target.glob("**/*") if f.is_file() and not os.path.islink(f))
    else:
        size_bytes = target.stat().st_size if not os.path.islink(target) else 0

    type_name = C.MAGENTA + t("folder_label") if is_dir else C.CYAN + t("file_label")
    if not ui_panel(t("ui_job"), [
        (t("ui_target"), f"{C.BOLD}{target.name}{C.RESET}"),
        (t("ui_type"), f"{type_name}{C.RESET}"),
        (t("ui_size"), fmt_size(size_bytes)),
        (t("ui_label"), f"{C.GREEN}{label}{C.RESET}"),
    ], "cyan"):
        log_info(t("target_info", name=f"{C.BOLD}{target.name}{C.RESET}", type=f"{type_name}{C.RESET}"))
        log_info(t("size_info", size=size_bytes / 1024))
        log_info(t("label_info", label=f"{C.GREEN}{label}{C.RESET}"))

    with tempfile.TemporaryDirectory() as tmpdir:
        tmp = Path(tmpdir)
        temp_enc = tmp / f"{label}.enc"
        unreadable_items = []
        special_files = []

        if is_dir:
            zip_path = tmp / "data.zip"
            n_files = count_files(target) if ui_on() else 0
            with step(t("compress_zip"), total=n_files or None) as st:
                unreadable_items, special_files = compress_directory(target, zip_path, on_file=st.advance)

            if special_files:
                log_warn(t("special_files_skipped", count=len(special_files)))
            if unreadable_items:
                log_warn(t("unreadable_warn", count=len(unreadable_items)))
                for upath, uerr in unreadable_items[:5]:
                    print(f"    {C.GRAY}• {upath}: {uerr}{C.RESET}")
                if len(unreadable_items) > 5:
                    print(f"    {C.GRAY}{t('and_more_entries', count=len(unreadable_items) - 5)}{C.RESET}")

            with open(zip_path, "rb") as f:
                raw_bytes = f.read()
        else:
            with step(t("encrypt_single")):
                with open(target, "rb") as f:
                    raw_bytes = f.read()

        with step(t("encrypting_cipher")):
            enc_bytes, key = encrypt_data(raw_bytes, label)
            with open(temp_enc, "wb") as f:
                f.write(enc_bytes)

        created_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        if local_only:
            out_enc = Path.cwd() / (output_filename if output_filename else f"{target.name}.enc")
            if not confirm_overwrite(out_enc, force=force):
                log_warn(t("cancelled_by_user"))
                if exit_on_error:
                    sys.exit(1)
                return 1

            old_label = None
            if out_enc.exists():
                try:
                    with open(out_enc, "rb") as old_fp:
                        old_header = old_fp.read(64)
                        if len(old_header) >= 5 and old_header[:4] in (MAGIC_GDE, MAGIC_EGD):
                            l_len = old_header[4]
                            old_label = old_header[5:5 + l_len].decode("utf-8", errors="ignore")
                except Exception:
                    pass

            # Simpan kunci ke DB lokal TERLEBIH DAHULU sebelum menyalin file keluar
            conn.execute(
                """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
                   VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                (label, target.name, str(target), is_dir, size_bytes, key.hex(), None, created_at)
            )
            conn.commit()

            try:
                # Bug #1: Salin secara atomik agar tidak menimpa inode hardlink yang ada
                atomic_copy_file(temp_enc, out_enc, mode=0o644)
                if old_label and old_label != label:
                    conn.execute("DELETE FROM vault WHERE label = ? AND drive_file_id IS NULL", (old_label,))
                    conn.commit()
            except Exception as e:
                conn.execute("DELETE FROM vault WHERE label = ?", (label,))
                conn.commit()
                log_err(f"{t('save_local_success', path=out_enc)}: {e}")
                if exit_on_error:
                    sys.exit(1)
                return 1

            if not ui_panel(t("ui_result"), [
                (t("ui_output"), f"{C.BOLD}{C.GREEN}{out_enc}{C.RESET}"),
                (t("ui_enc_size"), fmt_size(len(enc_bytes))),
                (t("ui_vault"), f"{C.DIM}{DB_PATH}{C.RESET}"),
            ], "green"):
                log_success(t("save_local_success", path=f"{C.BOLD}{C.GREEN}{out_enc}{C.RESET}"))
                log_success(t("key_saved_vault", path=f"{C.DIM}{DB_PATH}{C.RESET}"))
            log_info(t("restore_local_hint", name=f"{C.GREEN}{out_enc.name}{C.RESET}"))

            skipped_items = len(unreadable_items) + len(special_files)
            if skipped_items and not allow_partial:
                log_warn(t("partial_backup_warn", count=skipped_items))
                log_info(t("allow_partial_hint"))
                if exit_on_error:
                    sys.exit(2)
                return 2
            elif skipped_items:
                log_warn(t("partial_backup_allowed", count=skipped_items))
            else:
                log_done(t("done_local", name=f"{C.BOLD}{target.name}{C.RESET}"))
            return 0

        # Mode online: Simpan dulu kunci ke vault SEBELUM upload ke jaringan
        conn.execute(
            """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
               VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
            (label, target.name, str(target), is_dir, size_bytes, key.hex(), None, created_at)
        )
        conn.commit()

        mcp = GDriveMCP()
        drive_file_id = None
        upload_err = None
        try:
            with step(t("uploading_mcp")):
                mcp.start()
                drive_file_id = mcp.upload_file(temp_enc, f"{label}.enc")
            if not ui_on():
                log_success(t("upload_success", id=f"{C.GREEN}{drive_file_id}{C.RESET}"))
            conn.execute("UPDATE vault SET drive_file_id = ? WHERE label = ?", (drive_file_id, label))
            conn.commit()
        except Exception as e:
            upload_err = e
        finally:
            mcp.close()

        if upload_err:
            fallback_enc = Path.cwd() / f"{target.name}.enc"
            if fallback_enc.exists() and not force:
                fallback_enc = Path.cwd() / f"{target.name}.{secrets.token_hex(4)}.enc"

            atomic_copy_file(temp_enc, fallback_enc, mode=0o644)
            log_err(f"GDrive MCP Error: {upload_err}")
            log_warn(t("upload_failed_fallback", path=f"{C.BOLD}{fallback_enc}{C.RESET}"))
            log_info(t("restore_local_hint", name=f"{C.GREEN}{fallback_enc.name}{C.RESET}"))
            if exit_on_error:
                sys.exit(1)
            return 1

        if not ui_panel(t("ui_result"), [
            (t("ui_dest"), "Google Drive (MCP)"),
            (t("ui_drive_id"), f"{C.GREEN}{drive_file_id}{C.RESET}"),
            (t("ui_label"), f"{C.GREEN}{label}{C.RESET}"),
            (t("ui_enc_size"), fmt_size(len(enc_bytes))),
            (t("ui_vault"), f"{C.DIM}{DB_PATH}{C.RESET}"),
        ], "green"):
            log_success(t("key_and_metadata_saved", path=f"{C.DIM}{DB_PATH}{C.RESET}"))

        skipped_items = len(unreadable_items) + len(special_files)
        if skipped_items and not allow_partial:
            log_warn(t("partial_backup_warn", count=skipped_items))
            log_info(t("allow_partial_hint"))
            if exit_on_error:
                sys.exit(2)
            return 2
        elif skipped_items:
            log_warn(t("partial_backup_allowed", count=skipped_items))
        else:
            log_done(t("cloud_done", name=f"{C.BOLD}{target.name}{C.RESET}"))
        return 0


def run_scheduled_backup(path_str, interval_seconds, local_only=False, force=False, allow_partial=False):
    """Run periodic scheduled backup for a file or directory at specified interval."""
    target = Path(path_str).expanduser().resolve()
    if not target.exists() and not os.path.islink(target):
        log_err(t("target_not_found", target=target))
        sys.exit(1)

    is_dir = target.is_dir() and not os.path.islink(target)
    dest_type = "Lokal" if (local_only and CURRENT_LANG == "id") else "Local" if local_only else "Google Drive (MCP)"
    type_str = t("folder_label") if is_dir else t("file_label")

    log_info(f"{C.BOLD}{t('sched_active')}{C.RESET}")
    log_info(t("sched_target", name=f"{C.BOLD}{target.name}{C.RESET}", type=f"{C.MAGENTA if is_dir else C.CYAN}{type_str}{C.RESET}"))
    log_info(t("sched_path", path=f"{C.DIM}{target}{C.RESET}"))
    log_info(t("sched_interval", formatted=f"{C.YELLOW}{format_duration(interval_seconds)}{C.RESET}", seconds=interval_seconds))
    log_info(t("sched_storage", dest=f"{C.GREEN if not local_only else C.YELLOW}{dest_type}{C.RESET}"))
    log_info(t("sched_ctrl_c"))

    cycle = 1
    effective_force = True if force or not sys.stdin.isatty() else force

    while True:
        now_dt = datetime.now()
        now_str = now_dt.strftime("%Y-%m-%d %H:%M:%S")
        header_text = f"{t('sched_cycle_header', cycle=cycle)} — {now_str}"
        sched_border = "═" * (len(header_text) + 4)
        if ui_on():
            Console().print()
            ui_rule(header_text)
        else:
            print(f"\n{C.CYAN}╔{sched_border}╗{C.RESET}")
            print(f"{C.CYAN}║  {C.BOLD}{header_text}{C.RESET}{C.CYAN}  ║{C.RESET}")
            print(f"{C.CYAN}╚{sched_border}╝{C.RESET}")

        custom_out = None
        if local_only:
            ts_compact = now_dt.strftime("%Y%m%d_%H%M%S")
            custom_out = f"{target.name}.{ts_compact}.enc"

        try:
            ret = cmd_encrypt(
                path_str,
                local_only=local_only,
                force=effective_force,
                allow_partial=allow_partial,
                exit_on_error=False,
                output_filename=custom_out
            )
            if ret == 0:
                if local_only and custom_out:
                    latest_link = Path.cwd() / f"{target.name}.enc"
                    try:
                        if latest_link.exists() or os.path.islink(latest_link):
                            latest_link.unlink()
                        os.symlink(custom_out, str(latest_link))
                    except Exception:
                        pass
                log_success(t("sched_cycle_success", cycle=cycle))
            elif ret == 2:
                log_warn(t("sched_cycle_warn", cycle=cycle))
            else:
                log_err(t("sched_cycle_fail", cycle=cycle))
        except Exception as e:
            log_err(f"Cycle #{cycle} error: {e}")

        # In scheduled mode, subsequent local backups force overwrite to avoid hanging on prompt
        effective_force = True

        next_time = datetime.fromtimestamp(datetime.now().timestamp() + interval_seconds)
        next_time_str = next_time.strftime("%Y-%m-%d %H:%M:%S")
        waiting_msg = t("sched_waiting_next", next_cycle=cycle + 1, next_time=f"{C.BOLD}{C.GREEN}{next_time_str}{C.RESET}{C.GRAY}", duration=format_duration(interval_seconds))
        if ui_on():
            Console().print()
            log_info(t("sched_waiting_next", next_cycle=cycle + 1, next_time=next_time_str, duration=format_duration(interval_seconds)))
        else:
            print(f"\n{C.GRAY}[*] {waiting_msg}{C.RESET}")
            print(f"{C.GRAY}[*] {t('sched_ctrl_c')}{C.RESET}\n")

        cycle += 1
        try:
            if ui_on():
                ui_countdown(interval_seconds, t("ui_wait_cycle", cycle=cycle))
            else:
                time.sleep(interval_seconds)
        except KeyboardInterrupt:
            print(f"\n{C.YELLOW}[!]{C.RESET} {t('sched_stopped')}")
            sys.exit(0)


def cmd_decrypt_file(enc_path_str, dest_dir=".", force=False, conn_override=None):
    """Decrypt a local .enc file using the key from local vault or user input."""
    enc_path = Path(enc_path_str).expanduser().resolve()
    if not enc_path.exists():
        log_err(t("target_not_found", target=enc_path))
        sys.exit(1)

    log_info(t("reading_enc", name=f"{C.BOLD}{enc_path.name}{C.RESET}"))
    with open(enc_path, "rb") as f:
        enc_data = f.read()

    if len(enc_data) < 5:
        log_err(t("enc_too_short"))
        sys.exit(1)

    magic = enc_data[:4]
    if magic not in (MAGIC_GDE, MAGIC_EGD):
        log_err(t("not_gde_file"))
        sys.exit(1)

    label_len = enc_data[4]
    label = enc_data[5:5 + label_len].decode("utf-8", errors="ignore")
    log_info(t("detected_label", label=f"{C.GREEN}{label}{C.RESET}"))

    conn = conn_override or init_db()
    cur = conn.cursor()
    cur.execute("SELECT original_name, is_dir, enc_key FROM vault WHERE label = ?", (label,))
    row = cur.fetchone()

    if row:
        name, is_dir, key_hex = row
        key = bytes.fromhex(key_hex)
        log_info(t("key_found_vault", name=f"{C.BOLD}{name}{C.RESET}"))
    else:
        log_warn(t("key_not_found_vault"))
        try:
            key_input = input(f"{C.CYAN}{t('enter_hex_key')}{C.RESET}").strip()
        except (EOFError, KeyboardInterrupt):
            print(f"\n{t('cancelled_or_closed')}")
            sys.exit(1)

        if not key_input or key_input.lower() == "q":
            sys.exit(1)
        try:
            key = bytes.fromhex(key_input)
            if len(key) != 32:
                raise ValueError(t("key_length_err"))
        except ValueError as ve:
            log_err(t("invalid_key_err", err=ve))
            sys.exit(1)
        name = enc_path.stem
        is_dir = 0

    try:
        with step(t("decrypting_with_key"), plain=False):
            dec_bytes, extracted_label = decrypt_data(enc_data, key)
            if extracted_label != label:
                raise ValueError("Label mismatch tag")
    except InvalidTag:
        log_err(t("decrypt_invalid_tag"))
        sys.exit(1)
    except Exception as e:
        log_err(t("decrypt_err", err=e))
        sys.exit(1)

    # Sanitasi ketat nama file (cegah path traversal)
    safe_name = Path(name).name
    if not safe_name or safe_name in (".", ".."):
        safe_name = f"{label}.restored"

    base_dest_dir = Path(dest_dir).resolve()
    dest = base_dest_dir / safe_name

    # Validasi bahwa parent target berada di dalam base_dest_dir
    if not is_subpath(dest.parent, base_dest_dir):
        log_err(f"Path traversal detected: {dest}")
        sys.exit(1)

    if not confirm_overwrite(dest, force=force):
        log_warn(t("cancelled_by_user"))
        sys.exit(1)

    # Hapus symlink lama pada lokasi tujuan sebelum menulis
    if os.path.islink(dest):
        log_warn(f"Target '{dest.name}' is an existing symlink. Removing before restoring...")
        dest.unlink()

    if is_dir:
        dest.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory() as tmpdir:
            tmp_zip = Path(tmpdir) / "restored.zip"
            tmp_zip.write_bytes(dec_bytes)
            if not ui_on():
                log_info(t("extracting_folder", dest=f"{C.BOLD}{dest}{C.RESET}"))
            with step(t("ui_extracting"), plain=False):
                extract_zip_faithful(tmp_zip, dest)
    else:
        # Tulis secara atomik dengan izin ketat 0600 (memutus hardlink lama secara aman)
        dest.parent.mkdir(parents=True, exist_ok=True)
        tmp_file = dest.parent / f".tmp_{secrets.token_hex(6)}"
        fd = os.open(str(tmp_file), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        try:
            with open(fd, "wb", closefd=False) as fp:
                fp.write(dec_bytes)
                fp.flush()
                os.fsync(fd)
            os.replace(tmp_file, dest)
        finally:
            os.close(fd)
            if tmp_file.exists():
                try:
                    tmp_file.unlink()
                except OSError:
                    pass
        log_info(t("writing_file_mode", dest=f"{C.BOLD}{dest}{C.RESET}"))

    log_done(t("decrypt_success", dest=f"{C.BOLD}{C.GREEN}{dest}{C.RESET}"))


