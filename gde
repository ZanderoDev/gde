            try:
                mcp.start()
                mcp.download_file(drive_file_id, enc_file)
            finally:
                mcp.close()

        if not enc_file.exists():
            log_err("Gagal: File hasil download tidak ditemukan.")
            sys.exit(1)

        log_info("Mendekripsi file dengan kunci dari database lokal...")
        with open(enc_file, "rb") as f:
            enc_data = f.read()

        try:
            dec_bytes, extracted_label = decrypt_data(enc_data, key)
            if extracted_label != label:
                raise ValueError("Mismatch label tag")
        except InvalidTag:
            log_err("Gagal dekripsi: Tag otentikasi tidak valid (data korup atau kunci salah)!")
            sys.exit(1)
        except Exception as e:
            log_err(f"Gagal dekripsi: {e}")
            sys.exit(1)

        if not confirm_overwrite(dest, force=force):
            log_warn("Dibatalkan oleh pengguna.")
            sys.exit(1)

        # Bug #1 defense: jika target adalah symlink yang sudah ada, hapus symlink
        if os.path.islink(dest):
            log_warn(f"Target '{dest}' adalah symlink yang sudah ada. Menghapus symlink sebelum memulihkan...")
            dest.unlink()

        if is_dir:
            log_info(f"Folder terdeteksi -> Mengekstrak ZIP ke: {C.BOLD}{dest}{C.RESET}")
            decrypted_zip = tmp / "restored.zip"
            decrypted_zip.write_bytes(dec_bytes)
            extract_zip_faithful(decrypted_zip, dest)
        else:
            # Bug #5 defense: tulis file baru dengan izin ketat 0600 via atomic replace
            dest.parent.mkdir(parents=True, exist_ok=True)
            tmp_file = dest.parent / f".tmp_{secrets.token_hex(6)}"
            fd = os.open(str(tmp_file), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            try:
                with open(fd, "wb", closefd=False) as fp:
                    fp.write(dec_bytes)
                    fp.flush()
                    os.fsync(fd)
                os.replace(tmp_file, dest)
            finally:
                os.close(fd)
                if tmp_file.exists():
                    try:
                        tmp_file.unlink()
                    except OSError:
                        pass
            log_info(f"Menulis file ke: {C.BOLD}{dest}{C.RESET} (mode 0600)")

        log_done(f"Berhasil di-restore ke: {C.BOLD}{C.GREEN}{dest}{C.RESET}")


def cmd_export_keys(out_path=None):
    """Export vault database to a backup JSON file with strict 0o600 permissions."""
    conn = init_db()
    cur = conn.cursor()
    cur.execute("SELECT id, label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at FROM vault")
    rows = cur.fetchall()

    data = []
    for r in rows:
        data.append({
            "id": r[0],
            "label": r[1],
            "original_name": r[2],
            "original_path": r[3],
            "is_dir": r[4],
            "size_bytes": r[5],
            "enc_key": r[6],
            "drive_file_id": r[7],
            "created_at": r[8]
        })

    if not out_path:
        out_path = Path.home() / ".config" / "gde" / f"vault-backup-{datetime.now().strftime('%Y%m%d%H%M%S')}.json"
    else:
        out_path = Path(out_path).resolve()

    # Bug #6 defense: Tulis ke file sementara lalu atomic replace
    if os.path.islink(out_path):
        out_path.unlink()

    out_path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = out_path.parent / f".tmp_export_{secrets.token_hex(6)}"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    fd = os.open(str(tmp_path), flags, 0o600)
    try:
        with open(fd, "w", encoding="utf-8", closefd=False) as f:
            json.dump(data, f, indent=2)
            f.flush()
            os.fsync(fd)
        os.replace(tmp_path, out_path)
    finally:
        os.close(fd)
        if tmp_path.exists():
            try:
                tmp_path.unlink()
            except OSError:
                pass

    log_done(f"Vault berhasil di-export ke: {C.BOLD}{C.GREEN}{out_path}{C.RESET} ({len(data)} entri)")
    log_warn("CATATAN: File export berisi kunci plaintext (izin file diset ketat 0600). Simpan di media aman!")


def cmd_import_keys(in_path):
    """Import keys from a backup JSON file with strict schema & path validation."""
    path = Path(in_path).expanduser().resolve()
    if not path.exists():
        log_err(f"File backup '{path}' tidak ditemukan.")
        sys.exit(1)

    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        log_err(f"Gagal membaca file backup JSON: {e}")
        sys.exit(1)

    if not isinstance(data, list):
        log_err("Format backup JSON tidak valid: Root harus berupa array.")
        sys.exit(1)

    conn = init_db()
    count = 0
    rejected = 0

    for item in data:
        if not isinstance(item, dict):
            rejected += 1
            continue

        label = str(item.get("label", "")).strip()
        if not re.match(r"^[a-zA-Z0-9_]{4,64}$", label):
            log_warn(f"Entri diabaikan: Format label tidak valid '{label}'")
            rejected += 1
            continue

        enc_key = str(item.get("enc_key", "")).strip()
        if not re.match(r"^[0-9a-fA-F]{64}$", enc_key):
            log_warn(f"Entri {label} diabaikan: Format kunci enkripsi harus 64 hex characters")
            rejected += 1
            continue

        raw_name = str(item.get("original_name", "")).strip()
        safe_name = Path(raw_name).name
        # Bug #2 defense: sanitasi ketat path traversal dari backup eksternal
        if not safe_name or safe_name in (".", "..") or "/" in raw_name or "\\" in raw_name:
            log_warn(f"Entri {label} terdeteksi path traversal ({raw_name}) -> disanitasi menjadi {safe_name or 'restored_file'}")
            safe_name = safe_name or f"{label}.restored"

        is_dir = 1 if item.get("is_dir") else 0
        size_bytes = int(item.get("size_bytes", 0)) if str(item.get("size_bytes", 0)).isdigit() else 0
        drive_file_id = str(item.get("drive_file_id")).strip() if item.get("drive_file_id") else None
        created_at = str(item.get("created_at", datetime.now().strftime("%Y-%m-%d %H:%M:%S")))

        cur = conn.cursor()
        cur.execute("SELECT id FROM vault WHERE label = ?", (label,))
        if not cur.fetchone():
            conn.execute(
                """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
                   VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                (label, safe_name, safe_name, is_dir, size_bytes, enc_key, drive_file_id, created_at)
            )
            count += 1

    conn.commit()
    log_done(f"Berhasil mengimpor {C.BOLD}{count}{C.RESET} kunci baru ke vault.")
    if rejected:
        log_warn(f"{rejected} entri tidak valid ditolak demi keamanan.")


def self_test():
    """Deterministic verification for single file, directory, symlinks, zip slip defense, and tamper detection."""
    log_info("Menjalankan self-test GDE...")
    with tempfile.TemporaryDirectory() as tmpdir:
        tmp = Path(tmpdir)

        # 1. Test Single File (Direct without zip)
        file_path = tmp / "document.md"
        test_content = b"# Top Secret Notes\nNo zip overhead for single files!"
        file_path.write_bytes(test_content)

        label_file = "gde_testfile01"
        enc_file, key_file = encrypt_data(file_path.read_bytes(), label_file)
        if enc_file[:4] != MAGIC_GDE:
            raise RuntimeError("Magic header mismatch on single file")

        # Decrypt single file
        dec_file, lbl = decrypt_data(enc_file, key_file)
        if lbl != label_file:
            raise RuntimeError("Label mismatch on single file")
        if dec_file != test_content:
            raise RuntimeError("Decrypted content mismatch on single file")

        # 2. Test Directory with empty dirs, relative symlinks, absolute symlinks, and read-only folder
        folder_path = tmp / "my_folder"
        folder_path.mkdir()
        empty_sub = folder_path / "empty_sub"
        empty_sub.mkdir()

        # Read-only directory containing a file
        ro_dir = folder_path / "readonly_dir"
        ro_dir.mkdir()
        (ro_dir / "ro_file.txt").write_text("inside readonly dir")
        ro_dir.chmod(0o555)

        # Executable script
        script_file = folder_path / "script.sh"
        script_file.write_text("#!/bin/sh\necho test\n")
        script_file.chmod(0o755)

        # Symlinks (relative, absolute harmless, absolute broken)
        os.symlink("script.sh", str(folder_path / "script_symlink"))
        os.symlink("/usr/bin/sh", str(folder_path / "abs_symlink"))
        os.symlink("/non_existent/target/path", str(folder_path / "broken_abs_symlink"))

        zip_p = tmp / "folder.zip"
        unreadable, special_files = compress_directory(folder_path, zip_p)
        if not zip_p.exists():
            raise RuntimeError("Folder zip compression failed")
        if unreadable:
            raise RuntimeError(f"Unexpected unreadable files in self_test: {unreadable}")

        label_dir = "gde_testdir02"
        enc_dir, key_dir = encrypt_data(zip_p.read_bytes(), label_dir)
        dec_dir, lbl_dir = decrypt_data(enc_dir, key_dir)
        if lbl_dir != label_dir:
            raise RuntimeError("Label mismatch on directory")
        if dec_dir != zip_p.read_bytes():
            raise RuntimeError("Decrypted zip bytes mismatch")

        restore_dir = tmp / "restored_folder"
        restore_zip = tmp / "restored.zip"
        restore_zip.write_bytes(dec_dir)
        extract_zip_faithful(restore_zip, restore_dir)

        # Verifikasi hasil restorasi
        if not (restore_dir / "empty_sub").is_dir():
            raise RuntimeError("Empty subfolder not preserved in zip restore")
        if not (restore_dir / "readonly_dir" / "ro_file.txt").is_file():
            raise RuntimeError("File inside readonly directory missing")
        restored_script = restore_dir / "script.sh"
        if not restored_script.is_file():
            raise RuntimeError("script.sh missing in restored folder")
        restored_mode = stat.S_IMODE(restored_script.stat().st_mode)
        if restored_mode != 0o755:
            raise RuntimeError(f"Permissions not preserved: expected 0o755, got {oct(restored_mode)}")

        # Verifikasi symlinks (relatif dan absolut)
        if not os.path.islink(str(restore_dir / "script_symlink")):
            raise RuntimeError("Relative symlink not preserved")
        if not os.path.islink(str(restore_dir / "abs_symlink")):
            raise RuntimeError("Absolute symlink not preserved")
        if os.readlink(str(restore_dir / "abs_symlink")) != "/usr/bin/sh":
            raise RuntimeError("Absolute symlink target mismatch")
        if not os.path.islink(str(restore_dir / "broken_abs_symlink")):
            raise RuntimeError("Broken absolute symlink not preserved")

        # Kembalikan permission ro_dir agar TemporaryDirectory bisa menghapusnya
        os.chmod(str(ro_dir), 0o755)
        os.chmod(str(restore_dir / "readonly_dir"), 0o755)

        # 3. Tamper test: Corrupted ciphertext MUST fail decryption specifically with InvalidTag
        tampered_cipher = bytearray(enc_file)
        tampered_cipher[-1] ^= 0x01
        try:
            decrypt_data(bytes(tampered_cipher), key_file)
        except InvalidTag:
            pass
        else:
            raise RuntimeError("Tamper detection failed! Corrupted ciphertext was accepted or failed with wrong error.")

        # 4. Tamper test: Tampered label in header MUST fail decryption
        tampered_header = bytearray(enc_file)
        tampered_header[5] ^= 0x01
        try:
            decrypt_data(bytes(tampered_header), key_file)
        except (InvalidTag, ValueError):
            pass
        else:
            raise RuntimeError("Tamper detection failed! Tampered label was accepted.")

        # 5. Wrong key MUST fail decryption specifically with InvalidTag
        wrong_key = secrets.token_bytes(32)
        try:
            decrypt_data(enc_file, wrong_key)
        except InvalidTag:
            pass
        else:
            raise RuntimeError("Key verification failed! Wrong key was accepted.")

        # 6. Atomic export test & fchmod on existing file
        export_test_p = tmp / "export_test.json"
        export_test_p.write_text("{}")
        os.chmod(str(export_test_p), 0o644)
        flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
        fd = os.open(str(export_test_p), flags, 0o600)
        os.fchmod(fd, 0o600)
        mode = stat.S_IMODE(os.stat(fd).st_mode)
        os.close(fd)
        if mode != 0o600:
            raise RuntimeError(f"Atomic file creation mode mismatch: {oct(mode)}")

        # 7. Comprehensive Zip Slip defense test:
        # Vector A: Directory symlink escape
        # Vector B: Same-name symlink collision (symlink 'x' -> victim, followed by regular file 'x')
        # Vector C: Path traversal (../)
        outside_trap = tmp / "outside_trap"
        outside_trap.mkdir()
        victim_dir = outside_trap / "victim_dir.txt"
        victim_name = outside_trap / "victim_same_name.txt"
        victim_dir.write_text("clean_dir")
        victim_name.write_text("clean_name")

        slip_zip_p = tmp / "slip_comprehensive.zip"
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            with zipfile.ZipFile(slip_zip_p, "w") as zf:
                # Vector A: escape directory
                z_esc = zipfile.ZipInfo("escape_dir")
                z_esc.create_system = 3
                z_esc.external_attr = (stat.S_IFLNK | 0o777) << 16
                zf.writestr(z_esc, str(outside_trap))
                zf.writestr("escape_dir/victim_dir.txt", "hacked_dir")

                # Vector B: same-name collision
                z_same = zipfile.ZipInfo("collision_target")
                z_same.create_system = 3
                z_same.external_attr = (stat.S_IFLNK | 0o777) << 16
                zf.writestr(z_same, str(victim_name))
                zf.writestr("collision_target", "safe_replacement_content")

                # Vector C: Path traversal
                zf.writestr("../../evil.txt", "evil")
                zf.writestr("safe.txt", "safe")

        slip_target = tmp / "slip_target"
        extract_zip_faithful(slip_zip_p, slip_target)

        if victim_dir.read_text() != "clean_dir":
            raise RuntimeError("Zip Slip vulnerability: victim_dir was overwritten through escape symlink!")
        if victim_name.read_text() != "clean_name":
            raise RuntimeError("Zip Slip vulnerability: victim_name was overwritten through same-name symlink collision!")
        if (tmp / "evil.txt").exists():
            raise RuntimeError("Zip Slip vulnerability: ../ traversal succeeded!")
        if (slip_target / "collision_target").read_text() != "safe_replacement_content":
            raise RuntimeError("Collision target was not safely extracted as file!")
        if not (slip_target / "safe.txt").is_file():
            raise RuntimeError("Safe zip member missing.")

        # 8. Restore symlink overwrite defense test (Bug #1 defense)
        outside_restore_victim = tmp / "outside_restore_victim.txt"
        outside_restore_victim.write_text("pristine")
        restore_fake_dest = tmp / "fake_dest.txt"
        os.symlink(str(outside_restore_victim), str(restore_fake_dest))
        # When unlinked and written securely with mode 0600:
        if os.path.islink(restore_fake_dest):
            restore_fake_dest.unlink()
        tmp_sec = tmp / f".tmp_{secrets.token_hex(4)}"
        fd_sec = os.open(str(tmp_sec), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with open(fd_sec, "wb", closefd=False) as fp:
            fp.write(b"restored_safely")
        os.replace(tmp_sec, restore_fake_dest)
        os.close(fd_sec)

        if outside_restore_victim.read_text() != "pristine":
            raise RuntimeError("Restore bug: outside victim was overwritten through existing symlink!")
        if stat.S_IMODE(restore_fake_dest.stat().st_mode) != 0o600:
            raise RuntimeError("Restored file mode should be 0600")

    log_done("Self-test lolos:")
    print(f"    {C.GREEN}•{C.RESET} Single file (direct encrypt, no zip): {C.GREEN}OK{C.RESET}")
