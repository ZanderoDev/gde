    print(f"{C.BOLD}{C.RED}[-]{C.RESET} {msg}", file=sys.stderr)

MAGIC_GDE = b"GDE1"
MAGIC_EGD = b"EGD1"  # backwards compatibility
DB_DIR = Path.home() / ".config" / "gde"
LEGACY_DB = Path.home() / ".config" / "egd" / "vault.db"
DB_PATH = DB_DIR / "vault.db"


def init_db():
    DB_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(DB_DIR, 0o700)

    # Migrate from legacy egd path if needed
    if not DB_PATH.exists() and LEGACY_DB.exists():
        shutil.copy2(LEGACY_DB, DB_PATH)

    conn = sqlite3.connect(DB_PATH)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS vault (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            label TEXT UNIQUE NOT NULL,
            original_name TEXT NOT NULL,
            original_path TEXT NOT NULL,
            is_dir INTEGER NOT NULL,
            size_bytes INTEGER NOT NULL,
            enc_key TEXT NOT NULL,
            drive_file_id TEXT,
            created_at TEXT NOT NULL
        )
    """)
    conn.commit()
    os.chmod(DB_PATH, 0o600)
    return conn


def is_subpath(child, parent):
    """Check if child path resolves within parent path."""
    try:
        Path(child).resolve().relative_to(Path(parent).resolve())
        return True
    except ValueError:
        return False


class GDriveMCP:
    """Communicate with @piotr-agier/google-drive-mcp via stdio JSON-RPC."""

    def __init__(self, timeout=60):
        self.proc = None
        self.timeout = timeout
        self.stderr_buf = []
        self._stdout_queue = queue.Queue()
        self._threads = []

    def _drain_stdout(self):
        try:
            for line in iter(self.proc.stdout.readline, ""):
                if not line:
                    break
                self._stdout_queue.put(line)
        except Exception:
            pass

    def _drain_stderr(self):
        try:
            for line in iter(self.proc.stderr.readline, ""):
                if not line:
                    break
                self.stderr_buf.append(line)
                if len(self.stderr_buf) > 100:
                    self.stderr_buf.pop(0)
        except Exception:
            pass

    def start(self):
        try:
            self.proc = subprocess.Popen(
                ["npx", "-y", "@piotr-agier/google-drive-mcp"],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1
            )
            t_out = threading.Thread(target=self._drain_stdout, daemon=True)
            t_err = threading.Thread(target=self._drain_stderr, daemon=True)
            t_out.start()
            t_err.start()
            self._threads = [t_out, t_err]

            init_res = self._send({
                "jsonrpc": "2.0",
                "id": 1,
                "method": "initialize",
                "params": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {},
                    "clientInfo": {"name": "gde-cli", "version": "1.3.1"}
                }
            })
            if "error" in init_res:
                raise RuntimeError(f"MCP init failed: {init_res['error']}")
            self.proc.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
            self.proc.stdin.flush()
        except FileNotFoundError:
            raise RuntimeError("Command 'npx' tidak ditemukan. Pastikan Node.js terinstall.")

    def _send(self, req):
        req_id = req.get("id")
        self.proc.stdin.write(json.dumps(req) + "\n")
        self.proc.stdin.flush()
        deadline = datetime.now().timestamp() + self.timeout

        while True:
            remaining = deadline - datetime.now().timestamp()
            if remaining <= 0:
                raise TimeoutError(f"Timeout menunggu response MCP server ({self.timeout} detik).")

            try:
                line = self._stdout_queue.get(timeout=min(remaining, 1.0))
            except queue.Empty:
                if self.proc.poll() is not None:
                    err = "".join(self.stderr_buf)
                    raise RuntimeError(f"MCP server berhenti mendadak (exit code {self.proc.returncode}): {err}")
                continue

            line = line.strip()
            if not line:
                continue

            try:
                data = json.loads(line)
            except json.JSONDecodeError:
                continue

            if req_id is not None and data.get("id") != req_id:
                continue

            return data

    def call_tool(self, tool_name, arguments):
        req = {
            "jsonrpc": "2.0",
            "id": secrets.randbelow(1000000),
            "method": "tools/call",
            "params": {
                "name": tool_name,
                "arguments": arguments
            }
        }
        resp = self._send(req)
        if "error" in resp:
            raise RuntimeError(f"RPC Error: {resp['error']}")
        result = resp.get("result", {})
        if result.get("isError"):
            msg = "".join(c.get("text", "") for c in result.get("content", []))
            raise RuntimeError(f"Tool Error: {msg}")
        return result

    def upload_file(self, local_path, remote_name):
        res = self.call_tool("uploadFile", {
            "localPath": str(Path(local_path).resolve()),
            "name": remote_name
        })
        text_out = "".join(c.get("text", "") for c in res.get("content", []))
        try:
            data = json.loads(text_out)
            file_id = data.get("fileId") or data.get("id")
            if file_id:
                return str(file_id)
        except Exception:
            pass
        import re
        m = re.search(r"(?:fileId|id)['\"]?:\s*['\"]([^'\"]+)['\"]", text_out, re.IGNORECASE)
        if m:
            return m.group(1)
        raise RuntimeError(f"Gagal mengambil fileId dari response Google Drive MCP: {text_out[:200]}")

    def download_file(self, file_id, local_path):
        self.call_tool("downloadFile", {
            "fileId": file_id,
            "localPath": str(Path(local_path).resolve()),
            "overwrite": True
        })

    def close(self):
        if self.proc:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=2)
            except Exception:
                pass


def compress_directory(src_dir, out_zip):
    """Compress directory preserving empty folders, all symlinks, and file permissions. Safely skips FIFOs."""
    src = Path(src_dir).resolve()
    unreadable = []
    special_files = []

    def on_walk_err(err):
        unreadable.append((err.filename, str(err)))

    with zipfile.ZipFile(out_zip, "w", zipfile.ZIP_DEFLATED) as zf:
        for root, dirs, files in os.walk(src, followlinks=False, onerror=on_walk_err):
            root_p = Path(root)

            for d in dirs:
                dir_p = root_p / d
                rel_p = dir_p.relative_to(src).as_posix()
                if os.path.islink(dir_p):
                    link_target = os.readlink(dir_p)
                    zinfo = zipfile.ZipInfo(rel_p)
                    zinfo.create_system = 3  # Unix
                    zinfo.external_attr = (stat.S_IFLNK | 0o777) << 16
                    zf.writestr(zinfo, link_target)
                else:
                    zinfo = zipfile.ZipInfo(f"{rel_p}/")
                    zinfo.create_system = 3  # Unix
                    try:
                        mode = dir_p.stat().st_mode
                        zinfo.external_attr = (mode & 0xFFFF) << 16
                    except OSError:
                        zinfo.external_attr = (stat.S_IFDIR | 0o755) << 16
                    zf.writestr(zinfo, b"")

            for f in files:
                full_p = root_p / f
                rel_p = full_p.relative_to(src).as_posix()

                try:
                    st = os.lstat(full_p)
                except OSError as e:
                    unreadable.append((str(full_p), str(e)))
                    continue

                if stat.S_ISLNK(st.st_mode):
                    link_target = os.readlink(full_p)
                    zinfo = zipfile.ZipInfo(rel_p)
                    zinfo.create_system = 3  # Unix
                    zinfo.external_attr = (stat.S_IFLNK | 0o777) << 16
                    zf.writestr(zinfo, link_target)
                elif stat.S_ISREG(st.st_mode):
                    try:
                        with open(full_p, "rb") as fp:
                            data = fp.read()
                    except OSError as e:
                        unreadable.append((str(full_p), str(e)))
                        continue
                    zinfo = zipfile.ZipInfo(rel_p)
                    zinfo.create_system = 3  # Unix
                    zinfo.external_attr = (st.st_mode & 0xFFFF) << 16
                    zinfo.compress_type = zipfile.ZIP_DEFLATED
                    zf.writestr(zinfo, data)
                else:
                    special_files.append(str(full_p))

    return unreadable, special_files


def extract_zip_faithful(zip_path, dest_dir):
    """Extract zip with Zip Slip protection while fully preserving relative and absolute symlinks."""
    dest = Path(dest_dir).resolve()
    dest.mkdir(parents=True, exist_ok=True)
    dir_perms = []

    with zipfile.ZipFile(zip_path, "r") as zf:
        for member in zf.infolist():
            # 1. Tolak nama entri yang memakai path traversal
            if member.filename.startswith("/") or ".." in member.filename.split("/"):
                log_warn(f"Entri arsip berbahaya ditolak (Path Traversal attempt): {member.filename}")
                continue

            target_path = dest / member.filename
            perm = (member.external_attr >> 16) & 0xFFFF
            is_symlink = stat.S_ISLNK(perm)
            is_dir = member.filename.endswith("/")

            if is_symlink:
                # Lokasi inode symlink harus berada di dalam dest
                if not is_subpath(target_path.parent, dest):
                    log_warn(f"Lokasi symlink di luar batas ditolak: {member.filename}")
                    continue

                link_target = zf.read(member).decode("utf-8")
                target_path.parent.mkdir(parents=True, exist_ok=True)
                if target_path.exists() or os.path.islink(target_path):
                    target_path.unlink()
                try:
                    os.symlink(link_target, target_path)
                except OSError:
                    pass
            elif is_dir:
                if not is_subpath(target_path, dest):
                    log_warn(f"Direktori di luar batas ditolak: {member.filename}")
                    continue
                target_path.mkdir(parents=True, exist_ok=True)
                dir_perms.append((target_path, perm & 0o777))
            else:
                # File biasa: parent path harus resolve di dalam dest (mencegah penulisan via symlink!)
                if not is_subpath(target_path.parent, dest):
                    log_warn(f"Penulisan file melewati symlink ditolak: {member.filename}")
                    continue

                target_path.parent.mkdir(parents=True, exist_ok=True)
                extracted = Path(zf.extract(member, dest))
                file_perm = perm & 0o777
                if file_perm:
                    try:
                        os.chmod(extracted, file_perm)
                    except Exception:
                        pass

    # Terapkan izin direktori setelah seluruh file diekstrak (dari path terdalam)
    dir_perms.sort(key=lambda x: len(x[0].parts), reverse=True)
    for dpath, dperm in dir_perms:
        if dperm:
            try:
                os.chmod(dpath, dperm)
            except Exception:
                pass


def encrypt_data(raw_bytes, label):
    """
    ChaCha20-Poly1305 AEAD cipher (IETF RFC 8439).
    Per-file 256-bit unique key + 96-bit nonce.
    Format: MAGIC(4) + label_len(1) + label(N) + nonce(12) + ciphertext + tag(16)
    AAD = label (tamper protection for label matching).
    """
    key = secrets.token_bytes(32)
    nonce = secrets.token_bytes(12)
    cipher = ChaCha20Poly1305(key)
    label_bytes = label.encode("utf-8")
    ct = cipher.encrypt(nonce, raw_bytes, associated_data=label_bytes)

    header = bytearray()
    header.extend(MAGIC_GDE)
    header.append(len(label_bytes))
    header.extend(label_bytes)
    header.extend(nonce)
    return bytes(header) + ct, key


def decrypt_data(enc_bytes, key):
    """Decrypt and verify integrity via Poly1305 auth tag."""
    if len(enc_bytes) < 4 + 1 + 12 + 16:
        raise ValueError("File terenkripsi tidak valid: ukuran terlalu pendek.")
    magic = enc_bytes[:4]
    if magic not in (MAGIC_GDE, MAGIC_EGD):
        raise ValueError("Header tidak valid: bukan file GDE/EGD terenkripsi.")

    label_len = enc_bytes[4]
    offset = 5
    label = enc_bytes[offset:offset + label_len].decode("utf-8")
    offset += label_len
    nonce = enc_bytes[offset:offset + 12]
    offset += 12
    ct = enc_bytes[offset:]

    cipher = ChaCha20Poly1305(key)
    return cipher.decrypt(nonce, ct, associated_data=label.encode("utf-8")), label


def confirm_overwrite(dest_path, force=False):
    """Check overwrite. Prevents silent overwrite when running non-interactively."""
    if force:
        return True
    if not dest_path.exists() and not os.path.islink(dest_path):
        return True

    if not sys.stdin.isatty():
        log_err(f"Target '{dest_path}' sudah ada. Gunakan flag --force untuk menimpa dalam mode non-interaktif.")
        return False

    prompt = f"{C.YELLOW}[!]{C.RESET} Target '{C.BOLD}{dest_path}{C.RESET}' sudah ada. Timpa? [y/N]: "
    ans = input(prompt).strip().lower()
    return ans in ("y", "yes")


def cmd_encrypt(path_str, local_only=False, force=False):
    target = Path(path_str).expanduser().resolve()
    if not target.exists() and not os.path.islink(target):
        log_err(f"Path '{target}' tidak ditemukan.")
        sys.exit(1)

    conn = init_db()
    label = f"gde_{secrets.token_hex(8)}"
    is_dir = 1 if target.is_dir() and not os.path.islink(target) else 0

    if is_dir:
        size_bytes = sum(f.stat().st_size for f in target.glob("**/*") if f.is_file() and not os.path.islink(f))
    else:
        size_bytes = target.stat().st_size if not os.path.islink(target) else 0

    log_info(f"Target      : {C.BOLD}{target.name}{C.RESET} ({C.MAGENTA + 'Folder' if is_dir else C.CYAN + 'File'}{C.RESET})")
    log_info(f"Ukuran asli : {C.YELLOW}{size_bytes / 1024:.2f} KB{C.RESET}")
    log_info(f"Label file  : {C.GREEN}{label}{C.RESET}")

    with tempfile.TemporaryDirectory() as tmpdir:
        tmp = Path(tmpdir)
        temp_enc = tmp / f"{label}.enc"
        unreadable_items = []

        if is_dir:
            log_info(f"Target adalah {C.MAGENTA}folder{C.RESET} -> Kompres ke ZIP...")
            zip_path = tmp / "data.zip"
            unreadable_items, special_files = compress_directory(target, zip_path)

            if special_files:
                log_warn(f"{len(special_files)} file khusus (FIFO/socket/device) dilewati untuk mencegah hang.")
            if unreadable_items:
                log_warn(f"{len(unreadable_items)} file/direktori tidak dapat dibaca karena masalah izin:")
                for upath, uerr in unreadable_items[:5]:
                    print(f"    {C.GRAY}• {upath}: {uerr}{C.RESET}")
                if len(unreadable_items) > 5:
                    print(f"    {C.GRAY}...dan {len(unreadable_items) - 5} entri lainnya.{C.RESET}")

            with open(zip_path, "rb") as f:
                raw_bytes = f.read()
        else:
            log_info(f"Target adalah {C.CYAN}file{C.RESET} -> Enkripsi langsung {C.BOLD}tanpa ZIP{C.RESET}...")
            with open(target, "rb") as f:
                raw_bytes = f.read()

        log_info("Mengenkripsi dengan ChaCha20-Poly1305 (256-bit key unik)...")
        enc_bytes, key = encrypt_data(raw_bytes, label)
        with open(temp_enc, "wb") as f:
            f.write(enc_bytes)

        created_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        if local_only:
            out_enc = Path.cwd() / f"{target.name}.enc"
            if not confirm_overwrite(out_enc, force=force):
                log_warn("Dibatalkan oleh pengguna.")
                sys.exit(1)

            shutil.copy2(temp_enc, out_enc)
            conn.execute(
                """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
                   VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                (label, target.name, str(target), is_dir, size_bytes, key.hex(), None, created_at)
            )
            conn.commit()
            log_success(f"File terenkripsi disimpan ke: {C.BOLD}{C.GREEN}{out_enc}{C.RESET}")
            log_success(f"Kunci tersimpan di vault lokal: {C.DIM}{DB_PATH}{C.RESET}")
            log_info(f"Untuk restore lokal: {C.GREEN}gde decrypt {out_enc.name}{C.RESET}")

            if unreadable_items and not force:
                log_warn(f"Selesai DENGAN PERINGATAN: Backup parsial ({len(unreadable_items)} entri dilewati).")
                sys.exit(2)
            log_done(f"Selesai: {C.BOLD}{target.name}{C.RESET} terenkripsi lokal.")
            return

        # Mode online: upload via Google Drive MCP
        log_info("Mengunggah ke Google Drive via MCP...")
        mcp = GDriveMCP()
        drive_file_id = None
        upload_err = None
        try:
            mcp.start()
            drive_file_id = mcp.upload_file(temp_enc, f"{label}.enc")
            log_success(f"Berhasil upload. Drive ID: {C.GREEN}{drive_file_id}{C.RESET}")
        except Exception as e:
            upload_err = e
        finally:
            mcp.close()

        if upload_err:
            fallback_enc = Path.cwd() / f"{target.name}.enc"
            if fallback_enc.exists() and not force:
                fallback_enc = Path.cwd() / f"{target.name}.{secrets.token_hex(4)}.enc"

            shutil.copy2(temp_enc, fallback_enc)
            conn.execute(
                """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
                   VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                (label, target.name, str(target), is_dir, size_bytes, key.hex(), None, created_at)
            )
            conn.commit()
            log_err(f"GDrive MCP Error: {upload_err}")
            log_warn(f"Upload gagal. File terenkripsi diamankan ke: {C.BOLD}{fallback_enc}{C.RESET}")
            log_info(f"Kunci tersimpan di vault. Untuk restore: {C.GREEN}gde decrypt {fallback_enc.name}{C.RESET}")
            sys.exit(1)

        conn.execute(
            """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
               VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
            (label, target.name, str(target), is_dir, size_bytes, key.hex(), drive_file_id, created_at)
        )
        conn.commit()
        log_success(f"Kunci & metadata aman tersimpan di {C.DIM}{DB_PATH}{C.RESET}")

        if unreadable_items and not force:
            log_warn(f"Selesai DENGAN PERINGATAN: Backup cloud parsial ({len(unreadable_items)} entri dilewati).")
            sys.exit(2)
        log_done(f"Selesai: {C.BOLD}{target.name}{C.RESET} terenkripsi penuh di cloud.")


def cmd_decrypt_file(enc_path_str, dest_dir=".", force=False):
    """Decrypt a local .enc file using the key from local vault or user input."""
    enc_path = Path(enc_path_str).expanduser().resolve()
    if not enc_path.exists():
        log_err(f"File terenkripsi '{enc_path}' tidak ditemukan.")
        sys.exit(1)

    log_info(f"Membaca file terenkripsi: {C.BOLD}{enc_path.name}{C.RESET}")
    with open(enc_path, "rb") as f:
        enc_data = f.read()

    if len(enc_data) < 5:
        log_err("Format file tidak valid (terlalu pendek).")
        sys.exit(1)

    magic = enc_data[:4]
    if magic not in (MAGIC_GDE, MAGIC_EGD):
        log_err("Bukan file terenkripsi GDE/EGD.")
        sys.exit(1)

    label_len = enc_data[4]
    label = enc_data[5:5 + label_len].decode("utf-8", errors="ignore")
    log_info(f"Terdeteksi label: {C.GREEN}{label}{C.RESET}")

    conn = init_db()
    cur = conn.cursor()
    cur.execute("SELECT original_name, is_dir, enc_key FROM vault WHERE label = ?", (label,))
    row = cur.fetchone()

    if row:
        name, is_dir, key_hex = row
        key = bytes.fromhex(key_hex)
        log_info(f"Kunci ditemukan di vault untuk file: {C.BOLD}{name}{C.RESET}")
    else:
        log_warn("Kunci untuk label ini tidak ditemukan di database vault lokal.")
        try:
            key_input = input(f"{C.CYAN}Masukkan 64-karakter hex key (atau 'q' keluar): {C.RESET}").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nDibatalkan atau stream input ditutup.")
            sys.exit(1)

        if not key_input or key_input.lower() == "q":
            sys.exit(1)
        try:
            key = bytes.fromhex(key_input)
            if len(key) != 32:
                raise ValueError("Panjang kunci harus 32 byte (64 hex characters)")
        except ValueError as ve:
            log_err(f"Kunci tidak valid: {ve}")
            sys.exit(1)
        name = enc_path.stem
        is_dir = 0

    try:
        dec_bytes, extracted_label = decrypt_data(enc_data, key)
        if extracted_label != label:
            raise ValueError("Label mismatch tag")
    except InvalidTag:
        log_err("Gagal dekripsi: Kunci salah atau data telah diubah/korup (InvalidTag)!")
        sys.exit(1)
    except Exception as e:
        log_err(f"Gagal dekripsi: {e}")
        sys.exit(1)

    dest = Path(dest_dir).resolve() / name
    if not confirm_overwrite(dest, force=force):
        log_warn("Dibatalkan oleh pengguna.")
        sys.exit(1)

    if is_dir:
        with tempfile.TemporaryDirectory() as tmpdir:
            tmp_zip = Path(tmpdir) / "restored.zip"
            tmp_zip.write_bytes(dec_bytes)
            log_info(f"Mengekstrak folder ke: {C.BOLD}{dest}{C.RESET}")
            extract_zip_faithful(tmp_zip, dest)
    else:
        log_info(f"Menulis file ke: {C.BOLD}{dest}{C.RESET}")
        dest.write_bytes(dec_bytes)

    log_done(f"Berhasil didekripsi ke: {C.BOLD}{C.GREEN}{dest}{C.RESET}")


def cmd_list():
    conn = init_db()
    cur = conn.cursor()
    cur.execute("SELECT id, label, original_name, is_dir, size_bytes, drive_file_id, created_at FROM vault ORDER BY id DESC")
