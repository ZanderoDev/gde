        sys.exit(1)

    if not confirm_overwrite(dest, force=force):
        log_warn("Dibatalkan oleh pengguna.")
        sys.exit(1)

    # Bug #1 defense: jika target adalah symlink yang sudah ada, hapus symlink agar tidak tembus
    if os.path.islink(dest):
        log_warn(f"Target '{dest}' adalah symlink yang sudah ada. Menghapus symlink sebelum memulihkan...")
        dest.unlink()

    if is_dir:
        dest.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory() as tmpdir:
            tmp_zip = Path(tmpdir) / "restored.zip"
            tmp_zip.write_bytes(dec_bytes)
            log_info(f"Mengekstrak folder ke: {C.BOLD}{dest}{C.RESET}")
            extract_zip_faithful(tmp_zip, dest)
    else:
        # Bug #5 defense: tulis file baru dengan izin ketat 0600 via atomic replace
        dest.parent.mkdir(parents=True, exist_ok=True)
        tmp_file = dest.parent / f".tmp_{secrets.token_hex(6)}"
        fd = os.open(str(tmp_file), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        try:
            with open(fd, "wb", closefd=False) as fp:
                fp.write(dec_bytes)
                fp.flush()
                os.fsync(fd)
            os.replace(tmp_file, dest)
        finally:
            os.close(fd)
            if tmp_file.exists():
                try:
                    tmp_file.unlink()
                except OSError:
                    pass
        log_info(f"Menulis file ke: {C.BOLD}{dest}{C.RESET} (mode 0600)")

    log_done(f"Berhasil didekripsi ke: {C.BOLD}{C.GREEN}{dest}{C.RESET}")


