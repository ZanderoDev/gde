    def _tool_export_keys(self, out_path=None, conn_override=None):
        conn = conn_override or init_db()
        cur = conn.cursor()
        cur.execute("SELECT id, label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at FROM vault")
        rows = cur.fetchall()

        data = []
        for r in rows:
            data.append({
                "id": r[0],
                "label": r[1],
                "original_name": r[2],
                "original_path": r[3],
                "is_dir": r[4],
                "size_bytes": r[5],
                "enc_key": r[6],
                "drive_file_id": r[7],
                "created_at": r[8]
            })

        if not out_path:
            target_path = Path.home() / ".config" / "gde" / f"vault-backup-{datetime.now().strftime('%Y%m%d%H%M%S')}.json"
        else:
            raw_path = Path(out_path).expanduser()
            parent_dir = raw_path.parent.resolve()
            target_path = (parent_dir / raw_path.name).resolve()

        if not is_safe_mcp_path(target_path):
            raise PermissionError(f"Access to path '{target_path}' is restricted for MCP security.")

        target_path.parent.mkdir(parents=True, exist_ok=True)
        if os.path.islink(target_path):
            target_path.unlink()

        tmp_path = target_path.parent / f".tmp_export_{secrets.token_hex(6)}"
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
        fd = os.open(str(tmp_path), flags, 0o600)
        try:
            with open(fd, "w", encoding="utf-8", closefd=False) as f:
                json.dump(data, f, indent=2)
                f.flush()
                os.fsync(fd)
            os.replace(tmp_path, target_path)
        finally:
            os.close(fd)
            if tmp_path.exists():
                try:
                    tmp_path.unlink()
                except OSError:
                    pass

        return {
            "status": "success",
            "export_path": str(target_path),
            "entries_count": len(data)
        }

    def _tool_import_keys(self, in_path: str, conn_override=None):
        path = Path(in_path).expanduser().resolve()
        if not path.exists():
            raise FileNotFoundError(f"Backup file '{path}' not found.")

        if not is_safe_mcp_path(path):
            raise PermissionError(f"Access to path '{path}' is restricted for MCP security.")

        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)

        if not isinstance(data, list):
            raise ValueError("Invalid JSON backup format: Root must be an array.")

        conn = conn_override or init_db()
        count = 0
        rejected = 0

        for item in data:
            if not isinstance(item, dict):
                rejected += 1
                continue

            label = str(item.get("label", "")).strip()
            if not re.match(r"^[a-zA-Z0-9_]{4,64}$", label):
                rejected += 1
                continue

            enc_key = str(item.get("enc_key", "")).strip()
            if not re.match(r"^[0-9a-fA-F]{64}$", enc_key):
                rejected += 1
                continue

            raw_name = str(item.get("original_name", "")).strip()
            safe_name = Path(raw_name).name
            if not safe_name or safe_name in (".", "..") or "/" in raw_name or "\\" in raw_name:
                safe_name = safe_name or f"{label}.restored"

            is_dir = 1 if item.get("is_dir") else 0
            size_bytes = int(item.get("size_bytes", 0)) if str(item.get("size_bytes", 0)).isdigit() else 0
            drive_file_id = str(item.get("drive_file_id")).strip() if item.get("drive_file_id") else None
            created_at = str(item.get("created_at", datetime.now().strftime("%Y-%m-%d %H:%M:%S")))

            cur = conn.cursor()
            cur.execute("SELECT id FROM vault WHERE label = ?", (label,))
            if not cur.fetchone():
                conn.execute(
                    """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
                       VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                    (label, safe_name, safe_name, is_dir, size_bytes, enc_key, drive_file_id, created_at)
                )
                count += 1

        conn.commit()
        return {
            "status": "success",
            "imported_count": count,
            "rejected_count": rejected
        }

    def serve_stdio(self, conn_override=None):
        real_stdout = sys.stdout
        sys.stdout = sys.stderr

        try:
            for line in iter(sys.stdin.readline, ""):
                if not line:
                    break
                line = line.strip()
                if not line:
                    continue
                try:
                    req = json.loads(line)
                except Exception as e:
                    err_resp = {
                        "jsonrpc": "2.0",
                        "id": None,
                        "error": {"code": -32700, "message": f"Parse error: {e}"}
                    }
                    real_stdout.write(json.dumps(err_resp) + "\n")
                    real_stdout.flush()
                    continue

                resp = self.handle_request(req, conn_override=conn_override)
                if resp is not None:
                    real_stdout.write(json.dumps(resp) + "\n")
                    real_stdout.flush()
        finally:
            sys.stdout = real_stdout


