    args = sys.argv[1:]
    force = False
    allow_partial = False

    if "--force" in args:
        force = True
        args.remove("--force")
    if "-f" in args:
        force = True
        args.remove("-f")

    if "--allow-partial" in args:
        allow_partial = True
        args.remove("--allow-partial")

    if not args or args[0] in ("-h", "--help"):
        print(f"\n{C.BOLD}{C.CYAN}  ╔═════════════════════════════════════════════════════════════╗{C.RESET}")
        print(f"{C.BOLD}{C.CYAN}  ║   GDE - Google Drive Encryption (ChaCha20-Poly1305 256)     ║{C.RESET}")
