#!/usr/bin/env python3
"""
gde - Google Drive Encryption CLI
Military-grade local encryption (ChaCha20-Poly1305) + local key vault + Google Drive MCP.
Direct file encryption (no zip) for single files, faithful zip for directories.
"""

import sys
import os
import json
import sqlite3
import zipfile
import secrets
import shutil
import tempfile
import subprocess
import stat
from pathlib import Path
from datetime import datetime

try:
    from cryptography.hazmat.primitives.ciphers.aead import ChaCha20Poly1305
    from cryptography.exceptions import InvalidTag
except ImportError:
    print("Error: 'cryptography' library required. Run: pip install cryptography", file=sys.stderr)
    sys.exit(1)

