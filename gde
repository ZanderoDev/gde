        print(f"  {C.GREEN}gde {C.MAGENTA}list{C.RESET}                Daftar file di vault & download interaktif")
        print(f"  {C.GREEN}gde {C.BLUE}download <id|label>{C.RESET} Download dari GDrive & pulihkan langsung")
        print(f"  {C.GREEN}gde {C.YELLOW}export-keys [file]{C.RESET}  Export cadangan kunci vault ke file JSON (chmod 600)")
        print(f"  {C.GREEN}gde {C.YELLOW}import-keys <file>{C.RESET}  Import kunci vault dari file JSON")
        print(f"  {C.GREEN}gde {C.GRAY}test{C.RESET}                Jalankan internal verification self-test")
        print(f"  {C.GRAY}Opsi tambahan:{C.RESET}")
        print(f"    {C.YELLOW}--force / -f{C.RESET}          Lewati konfirmasi penimpaan file saat restore/dekripsi")
        print(f"    {C.YELLOW}--allow-partial{C.RESET}       Abaikan error file/direktori tak terbaca (exit code 0 alih-alih 2)\n")
        sys.exit(0)

    cmd = args[0]
    if cmd == "list":
        cmd_list()
    elif cmd == "download":
        if len(args) < 2:
            log_err("Berikan ID atau Label file.")
            sys.exit(1)
        cmd_download(args[1], force=force)
    elif cmd == "decrypt":
        if len(args) < 2:
            log_err("Berikan path ke file .enc (contoh: gde decrypt dokumen.md.enc)")
            sys.exit(1)
        cmd_decrypt_file(args[1], force=force)
    elif cmd == "export-keys":
        out_file = args[1] if len(args) > 1 else None
        cmd_export_keys(out_file)
    elif cmd == "import-keys":
        if len(args) < 2:
            log_err("Berikan path file JSON backup.")
            sys.exit(1)
        cmd_import_keys(args[1])
    elif cmd == "test":
        self_test()
    elif cmd == "--local":
        if len(args) < 2:
            log_err("Berikan path file/folder.")
            sys.exit(1)
        cmd_encrypt(args[1], local_only=True, force=force, allow_partial=allow_partial)
    else:
        cmd_encrypt(cmd, local_only=False, force=force, allow_partial=allow_partial)


