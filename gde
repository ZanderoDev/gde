    try:
        dec_bytes, extracted_label = decrypt_data(enc_data, key)
        if extracted_label != label:
            raise ValueError("Label mismatch tag")
    except InvalidTag:
        log_err("Gagal dekripsi: Kunci salah atau data telah diubah/korup (InvalidTag)!")
        sys.exit(1)
    except Exception as e:
        log_err(f"Gagal dekripsi: {e}")
        sys.exit(1)

    # Bug #2 defense: pastikan nama file aman dari path traversal
    safe_name = Path(name).name
    if not safe_name or safe_name in (".", ".."):
