def cmd_delete(item_ids_or_labels, delete_remote=True, force=False, conn_override=None):
    """Delete one or more entries from the local vault, and optionally from Google Drive."""
    if not item_ids_or_labels:
        log_err(t("del_no_target"))
        return 1

    conn = conn_override or init_db()
    cur = conn.cursor()

    if isinstance(item_ids_or_labels, (str, int)):
        targets = [str(item_ids_or_labels)]
    else:
        targets = [str(x) for x in item_ids_or_labels]

    success_count = 0
    mcp = None

    try:
        for t_val in targets:
            clean_t = t_val.strip()
            if not clean_t:
                continue

            if clean_t.isdigit():
                cur.execute("SELECT id, label, original_name, drive_file_id FROM vault WHERE id = ?", (int(clean_t),))
            else:
                cur.execute("SELECT id, label, original_name, drive_file_id FROM vault WHERE label = ? OR original_name = ?", (clean_t, clean_t))

            rows = cur.fetchall()
            if not rows:
                log_warn(t("del_item_not_found", target=clean_t))
                continue

            for row in rows:
                fid, label, name, drive_id = row
                prompt_msg = t("del_confirm_prompt", name=f"{C.BOLD}{name}{C.RESET}", id=fid)
                if not force:
                    try:
                        ans = input(f"{C.YELLOW}[?]{C.RESET} {prompt_msg} [y/N]: ").strip().lower()
                    except KeyboardInterrupt:
                        print(f"\n{t('cancelled_by_user')}")
                        return 1
                    if ans not in ("y", "yes"):
                        log_info(t("cancelled_by_user"))
                        continue

                # Delete from Google Drive if present and requested
                if drive_id and delete_remote:
                    if not mcp:
                        mcp = GDriveMCP()
                        try:
                            mcp.start()
                        except Exception as e:
                            log_warn(f"GDrive MCP connection error: {e}")
                            mcp = None
                    if mcp:
                        try:
                            log_info(t("del_remote_start", id=f"{C.CYAN}{drive_id}{C.RESET}"))
                            mcp.delete_file(drive_id)
                            log_success(t("del_remote_success", id=f"{C.GREEN}{drive_id}{C.RESET}"))
                        except Exception as e:
                            log_warn(f"Google Drive delete warning: {e}")

                conn.execute("DELETE FROM vault WHERE id = ?", (fid,))
                conn.commit()
                log_done(t("del_success", name=f"{C.BOLD}{name}{C.RESET}", id=fid))
                success_count += 1
    finally:
        if mcp:
            mcp.close()

    return 0 if success_count > 0 else 1


def cmd_download(item_id_or_label, dest_dir=".", force=False, conn_override=None):
    conn = conn_override or init_db()
    cur = conn.cursor()
    if isinstance(item_id_or_label, int) or str(item_id_or_label).isdigit():
        cur.execute("SELECT id, label, original_name, original_path, is_dir, enc_key, drive_file_id FROM vault WHERE id = ?", (int(item_id_or_label),))
    else:
        cur.execute("SELECT id, label, original_name, original_path, is_dir, enc_key, drive_file_id FROM vault WHERE label = ? OR original_name = ?", (str(item_id_or_label), str(item_id_or_label)))

    row = cur.fetchone()
    if not row:
        log_err(t("item_not_found", item=item_id_or_label))
        sys.exit(1)

    _, label, name, original_path, is_dir, key_hex, drive_file_id = row
    key = bytes.fromhex(key_hex)

    safe_name = Path(name).name
    if not safe_name or safe_name in (".", ".."):
        safe_name = f"{label}.restored"

    base_dest_dir = Path(dest_dir).resolve()
    dest = base_dest_dir / safe_name
    if not is_subpath(dest.parent, base_dest_dir):
        log_err(f"Path traversal detected: {dest}")
        sys.exit(1)

    type_str = t("folder_label") if is_dir else t("file_label")
    type_fmt = f"{C.MAGENTA if is_dir else C.CYAN}{type_str}{C.RESET}"
    if not ui_panel(t("ui_restore_job"), [
        (t("ui_target"), f"{C.BOLD}{safe_name}{C.RESET}"),
        (t("ui_type"), type_fmt),
        (t("ui_label"), f"{C.GREEN}{label}{C.RESET}"),
        (t("ui_drive_id"), f"{C.GREEN}{drive_file_id}{C.RESET}" if drive_file_id else t("col_local")),
    ], "cyan"):
        log_info(t("download_process", name=f"{C.BOLD}{safe_name}{C.RESET}", label=f"{C.GREEN}{label}{C.RESET}", type=type_fmt))

    with tempfile.TemporaryDirectory() as tmpdir:
        tmp = Path(tmpdir)
        enc_file = tmp / f"{label}.enc"

        if not drive_file_id:
            candidates = [
                Path.cwd() / f"{safe_name}.enc",
                Path.cwd() / f"{label}.enc",
                Path(original_path).parent / f"{safe_name}.enc"
            ]
            found = None
            for cand in candidates:
                if cand.exists():
                    found = cand
                    break
            if found:
                enc_file = found
            else:
                log_err("Item ini tersimpan lokal (tanpa ID GDrive) dan file .enc tidak ditemukan di folder saat ini.")
                log_info(f"gde decrypt <path/ke/{safe_name}.enc>")
                sys.exit(1)
        else:
            mcp = GDriveMCP()
            try:
                dl_id = drive_file_id if ui_on() else f"{C.GREEN}{drive_file_id}{C.RESET}"
                with step(t("downloading_mcp", id=dl_id)):
                    mcp.start()
                    mcp.download_file(drive_file_id, enc_file)
            finally:
                mcp.close()

        if not enc_file.exists():
            log_err(t("download_file_missing"))
            sys.exit(1)

        with open(enc_file, "rb") as f:
            enc_data = f.read()

        try:
            with step(t("decrypting_with_key")):
                dec_bytes, extracted_label = decrypt_data(enc_data, key)
                if extracted_label != label:
                    raise ValueError("Mismatch label tag")
        except InvalidTag:
            log_err(t("decrypt_invalid_tag"))
            sys.exit(1)
        except Exception as e:
            log_err(t("decrypt_err", err=e))
            sys.exit(1)

        if not confirm_overwrite(dest, force=force):
            log_warn(t("cancelled_by_user"))
            sys.exit(1)

        if os.path.islink(dest):
            log_warn(f"Target '{dest.name}' is an existing symlink. Removing before restoring...")
            dest.unlink()

        if is_dir:
            dest.mkdir(parents=True, exist_ok=True)
            decrypted_zip = tmp / "restored.zip"
            decrypted_zip.write_bytes(dec_bytes)
            with step(t("ui_extracting"), plain=False):
                extract_zip_faithful(decrypted_zip, dest)
        else:
            # Tulis secara atomik dengan izin ketat 0600 (memutus hardlink lama dengan aman)
            dest.parent.mkdir(parents=True, exist_ok=True)
            tmp_file = dest.parent / f".tmp_{secrets.token_hex(6)}"
            fd = os.open(str(tmp_file), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            try:
                with open(fd, "wb", closefd=False) as fp:
                    fp.write(dec_bytes)
                    fp.flush()
                    os.fsync(fd)
                os.replace(tmp_file, dest)
            finally:
                os.close(fd)
                if tmp_file.exists():
                    try:
                        tmp_file.unlink()
                    except OSError:
                        pass
            log_info(t("writing_file_mode", dest=f"{C.BOLD}{dest}{C.RESET}"))

        log_done(t("restore_success", dest=f"{C.BOLD}{C.GREEN}{dest}{C.RESET}"))


def cmd_export_keys(out_path=None, conn_override=None):
    """Export vault database to a backup JSON file with strict 0o600 permissions."""
    conn = conn_override or init_db()
    cur = conn.cursor()
    cur.execute("SELECT id, label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at FROM vault")
    rows = cur.fetchall()

    data = []
    for r in rows:
        data.append({
            "id": r[0],
            "label": r[1],
            "original_name": r[2],
            "original_path": r[3],
            "is_dir": r[4],
            "size_bytes": r[5],
            "enc_key": r[6],
            "drive_file_id": r[7],
            "created_at": r[8]
        })

    if not out_path:
        target_path = Path.home() / ".config" / "gde" / f"vault-backup-{datetime.now().strftime('%Y%m%d%H%M%S')}.json"
    else:
        raw_path = Path(out_path).expanduser()
        parent_dir = raw_path.parent.resolve()
        target_path = parent_dir / raw_path.name

    target_path.parent.mkdir(parents=True, exist_ok=True)

    # Bug #1 fix: Hapus symlink pada target_path jika sudah ada (cegah menimpa target symlink)
    if os.path.islink(target_path):
        target_path.unlink()

    tmp_path = target_path.parent / f".tmp_export_{secrets.token_hex(6)}"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    fd = os.open(str(tmp_path), flags, 0o600)
    try:
        with open(fd, "w", encoding="utf-8", closefd=False) as f:
            json.dump(data, f, indent=2)
            f.flush()
            os.fsync(fd)
        os.replace(tmp_path, target_path)
    finally:
        os.close(fd)
        if tmp_path.exists():
            try:
                tmp_path.unlink()
            except OSError:
                pass

    log_done(t("export_done", path=f"{C.BOLD}{C.GREEN}{target_path}{C.RESET}", count=len(data)))
    log_warn(t("export_note"))


def cmd_import_keys(in_path, conn_override=None):
    """Import keys from a backup JSON file with strict schema & path validation."""
    path = Path(in_path).expanduser().resolve()
    if not path.exists():
        log_err(t("backup_file_missing", path=path))
        sys.exit(1)

    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        log_err(t("backup_read_failed", err=e))
        sys.exit(1)

    if not isinstance(data, list):
        log_err(t("backup_format_invalid"))
        sys.exit(1)

    conn = conn_override or init_db()
    count = 0
    rejected = 0

    for item in data:
        if not isinstance(item, dict):
            rejected += 1
            continue

        label = str(item.get("label", "")).strip()
        if not re.match(r"^[a-zA-Z0-9_]{4,64}$", label):
            log_warn(f"Entri diabaikan: Format label tidak valid '{label}'")
            rejected += 1
            continue

        enc_key = str(item.get("enc_key", "")).strip()
        if not re.match(r"^[0-9a-fA-F]{64}$", enc_key):
            log_warn(f"Entri {label} diabaikan: Format kunci enkripsi harus 64 hex characters")
            rejected += 1
            continue

        raw_name = str(item.get("original_name", "")).strip()
        safe_name = Path(raw_name).name
        if not safe_name or safe_name in (".", "..") or "/" in raw_name or "\\" in raw_name:
            log_warn(f"Entri {label} terdeteksi path traversal ({raw_name}) -> disanitasi menjadi {safe_name or 'restored_file'}")
            safe_name = safe_name or f"{label}.restored"

        is_dir = 1 if item.get("is_dir") else 0
        size_bytes = int(item.get("size_bytes", 0)) if str(item.get("size_bytes", 0)).isdigit() else 0
        drive_file_id = str(item.get("drive_file_id")).strip() if item.get("drive_file_id") else None
        created_at = str(item.get("created_at", datetime.now().strftime("%Y-%m-%d %H:%M:%S")))

        cur = conn.cursor()
        cur.execute("SELECT id FROM vault WHERE label = ?", (label,))
        if not cur.fetchone():
            conn.execute(
                """INSERT INTO vault (label, original_name, original_path, is_dir, size_bytes, enc_key, drive_file_id, created_at)
                   VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                (label, safe_name, safe_name, is_dir, size_bytes, enc_key, drive_file_id, created_at)
            )
            count += 1

    conn.commit()
    log_done(t("import_done", count=f"{C.BOLD}{count}{C.RESET}"))
    if rejected:
        log_warn(t("import_rejected", count=rejected))


def cmd_set_lang(lang_code):
    """Set default interface language ('id' or 'en') and persist to config.json."""
    lang = lang_code.lower().strip()
    if lang not in ("id", "en"):
        log_err(t("lang_invalid"))
        sys.exit(1)

    DB_DIR.mkdir(parents=True, exist_ok=True)
    cfg = {}
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                cfg = json.load(f)
        except Exception:
            pass

    cfg["lang"] = lang
    with open(CONFIG_PATH, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
    try:
        os.chmod(CONFIG_PATH, 0o600)
    except OSError:
        pass

    set_current_lang(lang)
    log_done(t("lang_changed"))


