def ui_on(stream=None):
    stream = stream or sys.stdout
    try:
        tty = stream.isatty()
    except Exception:
        tty = False
    return _RICH_OK and not _UI_OFF and not os.environ.get("NO_COLOR") and tty


def _emit(icon, style, msg, err=False):
    con = Console(file=sys.stderr if err else sys.stdout, highlight=False)
    line = Text(f" {icon} ", style=style)
    line.append_text(Text.from_ansi(str(msg)))
    con.print(line)


def log_info(msg):
    if ui_on():
        return _emit("›", "bold cyan", msg)
    print(f"{C.CYAN}[*]{C.RESET} {msg}")

def log_success(msg):
    if ui_on():
        return _emit("✔", "green", msg)
    print(f"{C.GREEN}[+]{C.RESET} {msg}")

def log_done(msg):
    if ui_on():
        return _emit("✔", "bold green", msg)
    print(f"{C.BOLD}{C.GREEN}[✓]{C.RESET} {msg}")

def log_warn(msg):
    if ui_on():
        return _emit("▲", "bold yellow", msg)
    print(f"{C.YELLOW}[!]{C.RESET} {msg}")

def log_err(msg):
    if ui_on(sys.stderr):
        return _emit("✖", "bold red", msg, err=True)
    print(f"{C.BOLD}{C.RED}[-]{C.RESET} {msg}", file=sys.stderr)


class _NoStep:
    """Pengganti saat UI modern nonaktif: semua operasi no-op."""
    def advance(self, n=1):
        pass


class _LiveStep:
    def __init__(self, prog, tid):
        self._prog, self._tid = prog, tid

    def advance(self, n=1):
        self._prog.advance(self._tid, n)


@contextmanager
def step(msg, total=None, plain=True):
    """Satu tahap proses. UI modern: spinner (+ bar jika total diketahui) + waktu
    berjalan, lalu baris hasil ✔/✖ dengan durasi. Mode biasa: persis log_info(msg)."""
    if not ui_on():
        if plain:
            log_info(msg)
        yield _NoStep()
        return
    con = Console(highlight=False)
    cols = [SpinnerColumn("dots", style="cyan"), TextColumn("{task.description}")]
    if total:
        cols += [BarColumn(bar_width=28), MofNCompleteColumn()]
    cols.append(TimeElapsedColumn())
    prog = Progress(*cols, console=con, transient=True)
    start = time.monotonic()
    ok = False
    try:
        with prog:
            tid = prog.add_task(_esc(msg), total=total or None)
            yield _LiveStep(prog, tid)
        ok = True
    finally:
        dt = time.monotonic() - start
        con.print(Text.assemble(
            (" ✔ " if ok else " ✖ ", "green" if ok else "bold red"),
            msg.rstrip(".… "),
            (f"  {dt:.1f}s", "dim"),
        ))


def ui_panel(title, rows, style="cyan"):
    """Panel ringkasan key/value. Return True jika tampil; False jika UI nonaktif
    (pemanggil lalu memakai output teks lama)."""
    if not ui_on():
        return False
    grid = Table.grid(padding=(0, 2))
    grid.add_column(style="dim", no_wrap=True)
    grid.add_column(overflow="fold")
    for k, v in rows:
        grid.add_row(k, v if isinstance(v, Text) else Text.from_ansi(str(v)))
    Console(highlight=False).print(
        Panel(grid, title=f"[bold]{_esc(title)}[/]", title_align="left",
              border_style=style, box=box.ROUNDED, padding=(0, 1)))
    return True


def ui_rule(text, style="cyan"):
    if not ui_on():
        return False
    Console(highlight=False).rule(f"[bold]{_esc(text)}[/]", style=style, align="left")
    return True


def ui_countdown(seconds, label):
    """Hitung mundur dengan progress bar sampai siklus berikutnya (Ctrl+C = berhenti)."""
    con = Console(highlight=False)
    prog = Progress(SpinnerColumn("dots", style="cyan"), TextColumn("{task.description}"),
                    BarColumn(bar_width=30), TextColumn("[cyan]{task.fields[left]}"),
                    console=con, transient=True)
    with prog:
        tid = prog.add_task(_esc(label), total=seconds, left="")
        end = time.monotonic() + seconds
        while True:
            rem = end - time.monotonic()
            if rem <= 0:
                break
            r = int(rem) + 1
            prog.update(tid, completed=seconds - rem,
                        left=f"{r // 3600:02d}:{r % 3600 // 60:02d}:{r % 60:02d}")
            time.sleep(min(0.25, rem))


def fmt_size(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.2f} {unit}"
        n /= 1024


def count_files(path):
    return sum(len(fs) for _, _, fs in os.walk(path, followlinks=False))


